title: config corruption — invalid config rejected
description: Corrupt an application config value and verify the validation probe rejects it — designed to DEVIATE so the rollback restores the known-good config. The app-config control writes the known-good config and its backup before the run, so the steady-state probe only reads.

tags[2]: configuration, resilience
kind: robustness
target:
  system: config-service
  technology: file
  environment: demo

controls[1]:
  - name: app-config
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "d=/tmp/kd-demo/cfg; case \"$TUMULT_CONTROL_EVENT\" in before_experiment) mkdir -p $d; printf 'workers=4\\ntimeout=30\\n' > $d/app.conf; cp $d/app.conf $d/app.conf.bak; echo written;; esac"
      timeout_s: 5.0

steady_state_hypothesis:
  title: Application config has a sane timeout
  probes[1]:
    - name: config-valid
      activity_type: probe
      provider:
        type: process
        path: sh
        arguments[2]: "-c", "grep -q '^timeout=[1-9]' /tmp/kd-demo/cfg/app.conf 2>/dev/null && echo valid || echo invalid"
        timeout_s: 5.0
      tolerance:
        type: regex
        pattern: "^valid$"

method[1]:
  - name: corrupt-timeout
    activity_type: action
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "sed -i 's/^timeout=[0-9]*$/timeout=0/' /tmp/kd-demo/cfg/app.conf; echo corrupted"
      timeout_s: 5.0

rollbacks[1]:
  - name: restore-config
    activity_type: action
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "cp /tmp/kd-demo/cfg/app.conf.bak /tmp/kd-demo/cfg/app.conf; echo restored"
      timeout_s: 5.0

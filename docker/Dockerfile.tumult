# Tumult — chaos engineering platform (CLI + MCP server)
#
# Single image with both binaries, bundled providers, example experiments,
# and GameDay definitions. Use `tumult discover` for the runtime inventory.
#
# Build:
#   docker build -f docker/Dockerfile.tumult -t tumult .
#
# Usage (CLI):
#   docker run tumult run /opt/tumult/examples/redis-chaos.toon
#   docker run tumult analyze --all
#   docker run tumult gameday run /opt/tumult/gamedays/q2-postgres-resilience.gameday.toon
#   docker run tumult discover
#   docker run tumult --help
#
# The companion Dockerfile.tumult-mcp image selects the MCP binary and binds
# its authenticated Streamable HTTP endpoint for container use.

FROM rust:1.92.0-bookworm AS builder

WORKDIR /build
# Copy the whole build context (heavy dirs are excluded via .dockerignore) so
# that adding a new workspace crate never breaks the image build — the previous
# hand-maintained per-crate COPY list silently dropped new crates
# (tumult-graph, tumult-cloud), failing the build with "No such file or directory".
COPY . .

# tumult-net-proxyd is the userspace TCP proxy daemon that tumult-net faults
# spawn; it must ship alongside the main binary (located next to current_exe).
# `-p tumult-net` builds that crate's proxyd binary (it is not a bin of
# tumult-cli/tumult-mcp, so a scoped `--bin` there fails to resolve).
RUN cargo build --release -p tumult-cli -p tumult-mcp -p tumult-net && \
    strip target/release/tumult target/release/tumult-mcp target/release/tumult-net-proxyd

# ── Runtime ─────────────────────────────────────────────────
# Uses the builder image as base to avoid a second apt-get step.
# CI builds can use a multi-stage with debian:bookworm-slim for
# smaller images; this approach prioritizes build reliability.

FROM rust:1.92.0-bookworm AS runtime

# Install Docker CLI + tools needed by script plugins (docker exec, curl, ssh)
# The bookworm repos are already cached in this image — no network fetch needed
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    docker.io openssh-client curl wget psmisc procps && \
    rm -rf /var/lib/apt/lists/* /usr/local/cargo /usr/local/rustup

COPY --from=builder /build/target/release/tumult /usr/local/bin/
COPY --from=builder /build/target/release/tumult-mcp /usr/local/bin/
COPY --from=builder /build/target/release/tumult-net-proxyd /usr/local/bin/
COPY plugins/ /opt/tumult/plugins/
COPY examples/ /opt/tumult/examples/
COPY gamedays/ /opt/tumult/gamedays/

ENV TUMULT_PLUGIN_PATH=/opt/tumult/plugins

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD tumult --version || exit 1

EXPOSE 3100

ENTRYPOINT ["tumult"]
CMD ["--help"]

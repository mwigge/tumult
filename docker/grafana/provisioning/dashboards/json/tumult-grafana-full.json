{
  "annotations": {
    "list": []
  },
  "description": "Reference dashboard for the Grafana full stack (docker-compose.grafana-full.yml). Panels query the OTLP→Prometheus translated metric names (resilience.* → resilience_*). Not production-grade — a starting point.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "tumult-mimir"
      },
      "description": "Cumulative experiments by outcome (resilience.experiments.total).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "none"
        }
      },
      "pluginVersion": "12.4.6",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tumult-mimir"
          },
          "editorMode": "code",
          "expr": "sum by (status) (resilience_experiments_total)",
          "legendFormat": "{{status}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Experiments by status",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "tumult-mimir"
      },
      "description": "p95 action latency per plugin (resilience.action.duration_seconds histogram).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "none"
        }
      },
      "pluginVersion": "12.4.6",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tumult-mimir"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, plugin) (rate(resilience_action_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{plugin}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Action duration p95",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "tumult-tempo"
      },
      "description": "Recent traces from Tempo (reference). Use Explore → Tempo → Search/TraceQL for full search.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "pluginVersion": "12.4.6",
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tumult-tempo"
          },
          "limit": 20,
          "query": "{ resource.service.name = \"tumult\" }",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "Recent experiment traces (reference)",
      "type": "traces"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "tumult-loki"
      },
      "description": "Tumult log records; resilience.* attributes are structured metadata. Try filtering: | resilience_experiment_id=\"<id>\"",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "id": 4,
      "options": {
        "dedupStrategy": "none",
        "enableInfiniteScrolling": false,
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "pluginVersion": "12.4.6",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "tumult-loki"
          },
          "editorMode": "code",
          "expr": "{service_name=\"tumult\"} | json",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Experiment logs (reference)",
      "type": "logs"
    }
  ],
  "preload": false,
  "refresh": "30s",
  "schemaVersion": 40,
  "tags": [
    "tumult",
    "reference"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Tumult — Grafana Full Stack (reference)",
  "uid": "tumult-grafana-full",
  "version": 1
}

# Optional overrides. No .env is needed; enter AI API keys in the browser.
LAB_PORT=8089
# Existing local Ollama server (default). Local inference normally needs no key.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# To use Ollama cloud instead, set OLLAMA_BASE_URL=https://ollama.com,
# then enter an Ollama API key and a supported cloud model in AI settings.

# Tumult demo/local stack environment.
#
#   cp .env.example .env
#
# Then fill in the values below. `.env` is gitignored — never commit real
# secrets. These credentials are for LOCAL DEMO use only; never reuse them
# for a real deployment.

# ── Krönika demo stack (docker/docker-compose.kronika.yml) ─────────────────
# All three are REQUIRED: the compose file fails fast with an error if unset.
# Compose picks up .env automatically when you run from the repo root.

# Bootstrap password for the demo admin user (first boot only). The daemon
# binds 0.0.0.0 in the container and refuses to start on a non-loopback bind
# without a user (fail-closed guard, ADR-012), so this must be set.
# Generate: openssl rand -base64 24
KRONIKA_BOOTSTRAP_ADMIN_PASSWORD=

# API token provisioned for the seed/demo CLI on first boot. The daemon
# expects the production `kro_` token format.
# Generate: echo "kro_demo_seed_$(openssl rand -hex 32)"
KRONIKA_BOOTSTRAP_TOKEN=

# Bearer token required on the OTLP ingest endpoints (/v1/* HTTP + gRPC).
# The seed service sends it via OTEL_EXPORTER_OTLP_HEADERS.
# Generate: echo "kro_demo_ingest_$(openssl rand -hex 32)"
KRONIKA_INGEST_TOKEN=

# ── Optional (compose files carry safe local defaults) ─────────────────────

# MCP server auth token (docker-compose.tumult.yml / .aqe.yml / .demo.yml;
# default: tumult-dev / tumult-demo).
# TUMULT_MCP_TOKEN=

# OTLP endpoint for the tumult-mcp container
# (default: http://otel-collector:4317).
# OTEL_EXPORTER_OTLP_ENDPOINT=

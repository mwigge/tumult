title: Container pause — ${container}
description: Confirm the container responds, pause it, unpause it, confirm it recovers

tags[2]: container, resilience

steady_state_hypothesis:
  title: Container responds to ping
  probes[1]:
    - name: container-ping
      activity_type: probe
      provider:
        type: process
        path: sh
        arguments[2]: "-c", "docker exec ${container} redis-cli ping"
        timeout_s: 5.0
      tolerance:
        type: regex
        pattern: "PONG"

method[3]:
  - name: pause-container
    activity_type: action
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "docker pause ${container} && echo paused"
      timeout_s: 10.0
  - name: unpause-container
    activity_type: action
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "docker unpause ${container} && echo unpaused"
      timeout_s: 10.0
  - name: verify-recovered
    activity_type: probe
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "docker exec ${container} redis-cli ping"
      timeout_s: 5.0
    tolerance:
      type: regex
      pattern: "PONG"

rollbacks[1]:
  - name: ensure-unpaused
    activity_type: action
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "docker unpause ${container} 2>/dev/null || true"
      timeout_s: 10.0

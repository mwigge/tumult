title: PostgreSQL kill connections — ${container}
description: Verify PostgreSQL accepts queries, terminate idle backends, verify recovery

tags[2]: database, resilience

steady_state_hypothesis:
  title: PostgreSQL accepts queries
  probes[1]:
    - name: pg-query
      activity_type: probe
      provider:
        type: process
        path: sh
        arguments[2]: "-c", "docker exec ${container} psql -U ${pg_user} -d ${pg_database} -t -c 'SELECT version()' | head -1"
        timeout_s: 10.0
      tolerance:
        type: regex
        pattern: "PostgreSQL"

method[2]:
  - name: pg-kill-idle
    activity_type: action
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "docker exec ${container} psql -U ${pg_user} -d ${pg_database} -c \"SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE state='idle' AND pid != pg_backend_pid()\""
      timeout_s: 10.0
  - name: pg-verify-recovered
    activity_type: probe
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "docker exec ${container} psql -U ${pg_user} -d ${pg_database} -t -c 'SELECT version()' | head -1"
      timeout_s: 10.0
    tolerance:
      type: regex
      pattern: "PostgreSQL"

rollbacks[0]:

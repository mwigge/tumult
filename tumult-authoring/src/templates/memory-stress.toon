title: Memory stress — ${target}
description: Confirm the host is responsive, inject memory pressure with stress-ng, confirm it stays responsive

tags[2]: resource, resilience

steady_state_hypothesis:
  title: Host shell is responsive
  probes[1]:
    - name: host-alive
      activity_type: probe
      provider:
        type: process
        path: sh
        arguments[2]: "-c", "echo alive"
        timeout_s: 5.0
      tolerance:
        type: regex
        pattern: "alive"

method[2]:
  - name: memory-stress
    activity_type: action
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "stress-ng --vm ${workers} --vm-bytes ${bytes} --timeout ${duration} --metrics-brief 2>&1 | tail -1"
      timeout_s: 60.0
  - name: verify-responsive
    activity_type: probe
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "echo alive"
      timeout_s: 5.0
    tolerance:
      type: regex
      pattern: "alive"

rollbacks[0]:

 {
  "name": "author-new",
  "route": "/author/new?plugin=tumult-containers&action=pause-container",
  "height": 1100,
  "steps": [
   {
    "fill": [
     "input[placeholder^=\"pause-container\"]",
     "orders database pause, checkout retries"
    ]
   },
   {
    "fill": [
     "input[placeholder=\"e.g. demo-postgres\"]",
     "orders-db"
    ]
   },
   {
    "fill": [
     "input[placeholder=\"Target container id or name\"]",
     "orders-db"
    ]
   },
   {
    "fill": [
     "input[placeholder^=\"Container runtime\"]",
     "docker"
    ]
   },
   {
    "fill": [
     "input[placeholder^=\"pg_isready\"]",
     "pg_isready -h orders-db"
    ]
   },
   {
    "fill": [
     "input[placeholder=\"accepting connections\"]",
     "accepting connections"
    ]
   },
   {
    "click": "button:has-text(\"Generate TOON\")"
   },
   {
    "blur": true
   }
  ]
 },
 {
  "name": "runs-new",
  "route": "/runs/new?registry_id={registry.governed}",
  "height": 1220,
  "steps": [
   {
    "fill": [
     "input[placeholder=\"staging or production\"]",
     "dev"
    ]
   },
   {
    "fill": [
     "label:has-text(\"hold_s\") input",
     "30"
    ]
   },
   {
    "click": "button:has-text(\"Dry run\")"
   },
   {
    "waitFor": "text=Blast radius"

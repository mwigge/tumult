title: Process kill — verify a disrupted process can be detected and removed
description: Changes this host: pkill ends every process of this user whose command line is exactly sleep 300. Start a target process, confirm it exists, kill it, confirm it is gone

tags[3]: process, resilience, host-changing
kind: chaos
target:
  system: localhost
  technology: linux
  environment: local

steady_state_hypothesis:
  title: The host lists its running processes
  probes[1]:
    - name: list-processes
      activity_type: probe
      provider:
        type: process
        path: sh
        arguments[2]: "-c", "ps -o pid= -p $$"
        timeout_s: 5.0
      tolerance:
        type: regex
        pattern: "[0-9]+"

method[4]:
  - name: start-target
    activity_type: action
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "setsid sleep 300 >/dev/null 2>&1 < /dev/null & echo started"
      timeout_s: 5.0
  - name: verify-running
    activity_type: probe
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "i=0; until pgrep -f '^sleep 300$'; do i=$((i+1)); [ $i -gt 50 ] && echo missing && exit 0; sleep 0.1; done"
      timeout_s: 10.0
    tolerance:
      type: regex
      pattern: "[0-9]+"
  - name: kill-process
    activity_type: action
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "pkill -f '^sleep 300$'; echo killed"
      timeout_s: 5.0
  - name: verify-gone
    activity_type: probe
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "i=0; while pgrep -f '^sleep 300$' >/dev/null; do i=$((i+1)); [ $i -gt 50 ] && echo present && exit 0; sleep 0.1; done; echo gone"
      timeout_s: 10.0
    tolerance:
      type: regex
      pattern: "gone"

rollbacks[1]:
  - name: cleanup
    activity_type: action
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "pkill -f '^sleep 300$' 2>/dev/null || true"
      timeout_s: 5.0

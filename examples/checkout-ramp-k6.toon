title: Checkout API ramps from 5 to 50 users while the database hop is slow
description: A ramp profile rendered as k6 stages. Load climbs linearly for 60 s, then holds 50 VUs while Pumba adds 20 ms of delay to the network of the database container; p95 must stay under 400 ms and the health probe must keep answering.

tags[3]: load, ramp, checkout
kind: performance
target:
  system: checkout
  technology: http
  environment: staging
nfr[2]:
  - id: p95-under-load
    kind: latency
    metric: load.latency_p95_ms
    operator: lte
    threshold: 400
    criticality: blocking
  - id: errors
    kind: availability
    metric: load.error_rate
    operator: lte
    threshold: 0.01
    criticality: major

load:
  tool: k6
  script: examples/k6/smoke-test.js
  vus: 50
  duration_s: 180
  profile:
    type: ramp
    start_vus: 5
    ramp_up_s: 60

steady_state_hypothesis:
  title: Checkout answers
  probes[1]:
    - name: health
      activity_type: probe
      provider:
        type: process
        path: sh
        arguments[2]: "-c", "curl -fsS -o /dev/null http://127.0.0.1:8080/health"
        timeout_s: 5.0

method[1]:
  - name: slow-database
    activity_type: action
    pause_before_s: 60.0
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "docker run --rm --name tumult-ramp-netem -v /var/run/docker.sock:/var/run/docker.sock ghcr.io/alexei-led/pumba:latest netem -d 115s -i eth0 delay -t 20 demo-postgres"
      timeout_s: 150.0

rollbacks[1]:
  - name: stop-the-delay
    activity_type: action
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "docker stop tumult-ramp-netem 2>/dev/null || true"
      timeout_s: 30.0

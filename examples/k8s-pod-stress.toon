title: In-pod CPU stress via ephemeral debug container
description: Run stress-ng inside a target pod's process namespace, then verify it stays ready

tags[3]: kubernetes, stress, resilience

steady_state_hypothesis:
  title: Target pod is ready before injection
  probes[1]:
    - name: pod-ready
      activity_type: probe
      provider:
        type: native
        plugin: tumult-kubernetes
        function: pod_is_ready
        arguments:
          namespace: default
          name: nginx-test
      tolerance:
        type: regex
        pattern: "true"

method[2]:
  - name: inject-cpu-stress
    activity_type: action
    provider:
      type: native
      plugin: tumult-kubernetes
      function: pod_stress
      arguments:
        namespace: default
        pod: nginx-test
        cpu_workers: 2
        duration_s: 30
        target_container: nginx
        image: ghcr.io/colinianking/stress-ng:latest
    pause_after_s: 5.0
  - name: pod-still-ready
    activity_type: probe
    provider:
      type: native
      plugin: tumult-kubernetes
      function: pod_is_ready
      arguments:
        namespace: default
        name: nginx-test
    tolerance:
      type: regex
      pattern: "true"

rollbacks[0]:

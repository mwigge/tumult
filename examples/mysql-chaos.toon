title: MySQL resilience — verify queries succeed after connection disruption
description: Confirm MySQL answers a query, terminate idle connections, confirm it still answers

tags[2]: mysql, resilience

steady_state_hypothesis:
  title: MySQL answers a trivial query
  probes[1]:
    - name: mysql-select
      activity_type: probe
      provider:
        type: process
        path: sh
        arguments[2]: "-c", "docker exec docker-mysql-1 mysql -uroot -ptumult_test -N -e 'SELECT 1' 2>/dev/null"
        timeout_s: 10.0
      tolerance:
        type: regex
        pattern: "1"

method[2]:
  - name: kill-idle-connections
    activity_type: action
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "docker exec docker-mysql-1 sh -c \"mysql -uroot -ptumult_test -N -e 'SELECT id FROM information_schema.processlist WHERE command=\\\"Sleep\\\"' 2>/dev/null | while read id; do mysql -uroot -ptumult_test -e \\\"KILL \\$id\\\" 2>/dev/null || true; done; echo done\""
      timeout_s: 15.0
  - name: verify-recovered
    activity_type: probe
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "docker exec docker-mysql-1 mysql -uroot -ptumult_test -N -e 'SELECT 1' 2>/dev/null"
      timeout_s: 10.0
    tolerance:
      type: regex
      pattern: "1"

rollbacks[0]:

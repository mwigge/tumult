title: Redis freeze — a paused store gives no answer, then comes back with its data
description: Write a key, pause the Redis container, show that a client on the published port gets no answer while it is paused, unpause it and read the key back

tags[2]: redis, resilience

steady_state_hypothesis:
  title: Redis responds to ping
  probes[1]:
    - name: redis-ping
      activity_type: probe
      provider:
        type: process
        path: sh
        arguments[2]: "-c", "docker exec docker-redis-1 redis-cli ping"
        timeout_s: 5.0
      tolerance:
        type: regex
        pattern: "PONG"

method[5]:
  - name: redis-set-key
    activity_type: action
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "docker exec docker-redis-1 redis-cli SET tumult:test 'chaos-was-here'"
      timeout_s: 5.0
  - name: pause-redis
    activity_type: action
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "docker pause docker-redis-1 && echo paused"
      timeout_s: 10.0
  - name: no-answer-while-paused
    activity_type: probe
    provider:
      type: process
      path: bash
      arguments[2]: "-c", "exec 3<>/dev/tcp/127.0.0.1/16379 && printf 'PING\\r\\n' >&3 && timeout 2 head -c 5 <&3 || echo no-answer"
      timeout_s: 10.0
    tolerance:
      type: regex
      pattern: "no-answer"
  - name: unpause-redis
    activity_type: action
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "docker unpause docker-redis-1 && echo unpaused"
      timeout_s: 10.0
    pause_after_s: 1.0
  - name: key-survived
    activity_type: probe
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "docker exec docker-redis-1 redis-cli GET tumult:test"
      timeout_s: 5.0
    tolerance:
      type: regex
      pattern: "chaos-was-here"

rollbacks[2]:
  - name: ensure-unpaused
    activity_type: action
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "docker unpause docker-redis-1 2>/dev/null || true"
      timeout_s: 10.0
  - name: redis-cleanup
    activity_type: action
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "docker exec docker-redis-1 redis-cli DEL tumult:test"
      timeout_s: 5.0

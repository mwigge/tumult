title: PostgreSQL under k6 load — container pause disruption
description: k6 queries PG with real inserts/selects for 15 s while Pumba pauses the container; the method (3 s settle, 5 s pause, 8 s recovery) outlasts the load, so every second of it is measured

tags[4]: postgres, load, pumba, resilience
kind: chaos
target:
  system: postgres
  technology: postgresql
  environment: lab

load:
  tool: k6
  script: examples/k6/pg-load.js
  vus: 5
  duration_s: 15.0

steady_state_hypothesis:
  title: PostgreSQL accepts queries
  probes[1]:
    - name: pg-responds
      activity_type: probe
      provider:
        type: process
        path: sh
        arguments[2]: "-c", "docker exec docker-postgres-1 psql -U tumult -d tumult_test -t -c 'SELECT version()' | head -1"
        timeout_s: 10.0
      tolerance:
        type: regex
        pattern: "PostgreSQL"

method[3]:
  - name: connection-count-before
    activity_type: probe
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "sleep 3 && docker exec docker-postgres-1 psql -U tumult -d tumult_test -t -c 'SELECT count(*) FROM pg_stat_activity' | tr -d ' \n'"
      timeout_s: 10.0
  - name: pause-postgres-5s
    activity_type: action
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "docker run --rm -v /var/run/docker.sock:/var/run/docker.sock ghcr.io/alexei-led/pumba:1.6.0@sha256:11ed15538c7ec688628e2f53917d949e8c16418c146742731c3030ef276b6057 pause -d 5s docker-postgres-1"
      timeout_s: 10.0
    pause_after_s: 8.0
  - name: connection-count-after
    activity_type: probe
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "docker exec docker-postgres-1 psql -U tumult -d tumult_test -t -c 'SELECT count(*) FROM pg_stat_activity' | tr -d ' \n'"
      timeout_s: 10.0

rollbacks[0]:

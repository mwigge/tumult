title: DNS redirect — a name is sent to the wrong address and a lookup shows it
description: Changes this host: a line is added to /etc/hosts and removed again, so it needs root. Redirect a test name to 127.0.0.1 and check that a lookup on this host answers with that address.

tags[3]: dns, network, host-changing
kind: chaos
target:
  system: localhost
  technology: linux
  environment: local

steady_state_hypothesis:
  title: DNS resolves correctly
  probes[1]:
    - name: dns-baseline
      activity_type: probe
      provider:
        type: process
        path: sh
        arguments[2]: "-c", "dig +short google.com 2>/dev/null | head -1 || echo failed"
        timeout_s: 10.0
      tolerance:
        type: regex
        pattern: "\\d+\\.\\d+\\.\\d+\\.\\d+"

method[4]:
  - name: dns-latency-before
    activity_type: probe
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "dig +noall +stats google.com 2>/dev/null | awk '/Query time:/ {print $4}'"
      timeout_s: 10.0
  - name: redirect-dns
    activity_type: action
    provider:
      type: script
      plugin: tumult-network
      function: redirect-dns
      arguments:
        dns_domain: "test-redirect.tumult.local"
        dns_redirect: "127.0.0.1"
      timeout_s: 10.0
  - name: redirect-visible
    activity_type: probe
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "getent hosts test-redirect.tumult.local || echo unresolved"
      timeout_s: 10.0
    tolerance:
      type: regex
      pattern: "^127\\.0\\.0\\.1"
  - name: remove-redirect
    activity_type: action
    provider:
      type: script
      plugin: tumult-network
      function: redirect-dns-rollback
      timeout_s: 10.0

rollbacks[1]:
  - name: restore-dns
    activity_type: action
    provider:
      type: script
      plugin: tumult-network
      function: redirect-dns-rollback
      timeout_s: 10.0

title: Checkout API rejects malformed input without falling over
description: A robustness run with no fault injector. The method asks the checkout route for order ids that are not a number, too large, badly encoded and far too long, and expects 4xx answers, then holds for the rest of the load window, while the health probe stays green and the error rate of the background load stays flat.

tags[3]: robustness, malformed-input, checkout
kind: robustness
target:
  system: checkout
  technology: http
  environment: staging
nfr[1]:
  - id: survives-garbage
    kind: availability
    metric: during.availability
    operator: gte
    threshold: 0.999
    criticality: blocking

load:
  tool: oha
  script: http://127.0.0.1:8080/checkout/1
  vus: 5
  duration_s: 60

steady_state_hypothesis:
  title: Checkout answers
  probes[1]:
    - name: health
      activity_type: probe
      provider:
        type: process
        path: sh
        arguments[2]: "-c", "curl -fsS -o /dev/null http://127.0.0.1:8080/health"
        timeout_s: 5.0

method[4]:
  - name: not-a-number
    activity_type: probe
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "curl -s -o /dev/null -w '%{http_code}' -m 8 http://127.0.0.1:8080/checkout/abc"
      timeout_s: 10.0
    tolerance:
      type: regex
      pattern: "^4[0-9][0-9]$"
  - name: number-too-large
    activity_type: probe
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "curl -s -o /dev/null -w '%{http_code}' -m 8 http://127.0.0.1:8080/checkout/99999999999999999999"
      timeout_s: 10.0
    tolerance:
      type: regex
      pattern: "^4[0-9][0-9]$"
  - name: badly-encoded
    activity_type: probe
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "curl -s -o /dev/null -w '%{http_code}' -m 8 http://127.0.0.1:8080/checkout/%00%ff%fe"
      timeout_s: 10.0
    tolerance:
      type: regex
      pattern: "^4[0-9][0-9]$"
  - name: far-too-long
    activity_type: probe
    provider:
      type: process
      path: sh
      arguments[2]: "-c", "id=$(head -c 100000 /dev/zero | tr '\\0' 9); curl -s -o /dev/null -w '%{http_code}' -m 8 http://127.0.0.1:8080/checkout/$id"
      timeout_s: 10.0
    tolerance:
      type: regex
      pattern: "^4[0-9][0-9]$"
    pause_after_s: 60.0

rollbacks[0]:

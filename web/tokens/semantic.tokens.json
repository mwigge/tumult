{
  "$description": "The semantic tier: roles that are the same in every theme. The colour roles of each theme are in dark.tokens.json and light.tokens.json.",
  "mono": {
    "$type": "fontFamily",
    "$value": "{font.mono}",
    "$description": "The font of code, ids and numbers that line up in columns."
  },
  "chart": {
    "$description": "Charts draw on a canvas and cannot read CSS, so they take these from tokens.gen.ts. The series of each theme are in dark.tokens.json and light.tokens.json.",
    "font": {
      "$description": "The type of chart text. The canvas cannot read a custom property, so the chart takes the values.",
      "family": {
        "$type": "fontFamily",
        "$value": "{font-body}",
        "$description": "The font of chart text: the font of the page."
      },
      "weight": {
        "$type": "fontWeight",
        "$value": "{font-weight-strong}",
        "$description": "600, semi-bold. Text on a filled heatmap cell or treemap tile."
      },
      "size": {
        "$type": "dimension",
        "$description": "The sizes of chart text, smallest first.",
        "2xs": {
          "$value": {
            "value": 9,
            "unit": "px"
          },
          "$description": "9px. The kind under a caption of the Star Map, and the caption of an edge."
        },
        "xs": {
          "$value": {
            "value": 10,
            "unit": "px"
          },
          "$description": "10px. The name of a run over a chart of time."
        },
        "sm": {
          "$value": {
            "value": 11,
            "unit": "px"
          },
          "$description": "11px. Labels in a chart: a caption of the Star Map, a heatmap cell, the scale of a gauge."
        },
        "md": {
          "$value": {
            "value": 12,
            "unit": "px"
          },
          "$description": "12px. Tooltips and the labels of treemap tiles."
        },
        "lg": {
          "$value": {
            "value": 14,
            "unit": "px"
          },
          "$description": "14px. A value a chart shows large: the index of the maturity gauge. The size of a value on a page."
        }
      }
    },
    "ink-on-fill": {
      "$type": "color",
      "$value": "{grey.4}",
      "$description": "Text on a bright fill, such as a heatmap cell or a treemap tile, in every theme."
    },
    "neutral-dot": {
      "$type": "color",
      "$value": "{grey.57}",
      "$description": "The dot of a tooltip row whose colour is not one CSS can write, such as a gradient."
    },
    "band": {
      "$type": "color",
      "$description": "The bands of a score, and the coverage of a DORA heatmap cell from low to high. Okabe-Ito, so that readers with colour blindness can tell them apart. Each is 3:1 or more on the panel of each theme, and the ink on it 4.5:1.",
      "good": {
        "$value": "{okabe-ito.bluish-green}",
        "$description": "Good, or high coverage."
      },
      "fair": {
        "$value": "{okabe-ito.orange-deep}",
        "$description": "Fair, or middle coverage."
      },
      "poor": {
        "$value": "{okabe-ito.vermillion}",
        "$description": "Poor, or low coverage."
      }
    },
    "unscored": {
      "$type": "color",
      "$value": "{grey.51}",
      "$description": "A band with no score: neither good nor bad."
    },
    "status": {
      "$type": "color",
      "$description": "The evidence status of a DORA heatmap cell, by rank. Okabe-Ito. Each is 3:1 or more on the panel of each theme, and the ink on it 4.5:1.",
      "none": {
        "$value": "{okabe-ito.vermillion}",
        "$description": "Rank 0: no evidence."
      },
      "designed": {
        "$value": "{okabe-ito.orange-deep}",
        "$description": "Rank 1: the control is designed."
      },
      "existing": {
        "$value": "{okabe-ito.sky-blue-deep}",
        "$description": "Rank 2: the control exists."
      },
      "operating": {
        "$value": "{okabe-ito.bluish-green}",
        "$description": "Rank 3: the control operates."
      }
    },
    "starmap": {
      "$type": "color",
      "$description": "The Star Map, the same in every theme on purpose.",
      "kind": {
        "$description": "The fill of each kind of node, the same under every lens. Each is 3:1 or more on the dark and on the light panel. None is a status colour of either theme, and none is the yellow lost on white. They hold their own values: no other role uses them.",
        "org": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.298, 0.5569, 0.8549],
            "hex": "#4C8EDA"
          },
          "$description": "The fill of an org unit."
        },
        "entity": {

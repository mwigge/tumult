      "border-bottom": "1px solid rgb(36, 45, 54)",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row] > td[cell].mono \"run-1\" > a[link] \"run-1\"": {
      "color": "rgb(94, 177, 239)",

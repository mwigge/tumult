      "font-size": "11px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"EVENT\"": {

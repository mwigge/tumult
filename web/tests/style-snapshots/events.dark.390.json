    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"ACTOR\"": {
      "color": "rgb(139, 152, 165)",
      "font-size": "11px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"DETAIL\"": {
      "color": "rgb(139, 152, 165)",
      "font-size": "11px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tbody": {
      "display": "table-row-group"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row]": {
      "display": "table-row"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row] > td[cell] \"1h ago\"": {
      "display": "table-cell",
      "border-bottom": "1px solid rgb(36, 45, 54)",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row] > td[cell] \"started\"": {
      "display": "table-cell",
      "border-bottom": "1px solid rgb(36, 45, 54)",

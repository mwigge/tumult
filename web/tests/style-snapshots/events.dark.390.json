{
  "page": "events",
  "path": "/events",
  "theme": "dark",
  "width": 390,
  "height": 844,
  "elements": {
    "html": {
      "color": "rgb(216, 222, 228)",
      "font-family": "-apple-system, \"Segoe UI\", Inter, Roboto, sans-serif",
      "font-size": "13px",
      "font-weight": "400",
      "line-height": "1.5",
      "letter-spacing": "normal",
      "text-transform": "none",
      "visibility": "visible",
      "display": "block",
      "background-color": "rgb(11, 14, 17)"
    },
    "body": {
      "display": "block",
      "background-color": "rgb(11, 14, 17)"
    },
    "a[link].sr-only.skip-link \"Skip to main content\"": {
      "color": "rgb(94, 177, 239)",
      "display": "block"
    },
    "div.shell": {
      "display": "block",
      "grid-template-columns": "208px 1fr"
    },
    "div.shell > header[banner].topbar": {
      "display": "flex",
      "background-color": "rgb(17, 22, 27)",
      "border-bottom": "1px solid rgb(36, 45, 54)",
      "padding": "8px 16px"
    },
    "div.shell > header[banner].topbar > span.name": {
      "font-size": "18px",
      "font-weight": "700",
      "letter-spacing": "0.5px",
      "display": "block"
    },
    "div.shell > header[banner].topbar > button[button].btn \"Menu\"": {
      "font-family": "Arial",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(28, 36, 44)",
      "border-top": "1px solid rgb(51, 64, 76)",
      "border-right": "1px solid rgb(51, 64, 76)",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "border-left": "1px solid rgb(51, 64, 76)",
      "border-radius": "6px",
      "padding": "8px 16px"
    },
    "div.shell > main[main].main": {
      "display": "block",
      "padding": "24px 16px 60px"
    },
    "div.shell > main[main].main > div.page-head": {
      "display": "flex",
      "margin": "0px 0px 20px",
      "gap": "16px"
    },
    "div.shell > main[main].main > div.page-head > h1[heading] \"Events\"": {
      "font-size": "18px",
      "font-weight": "600",
      "display": "block"
    },
    "div.shell > main[main].main > div.page-head > span.sub": {
      "color": "rgb(139, 152, 165)",
      "font-size": "12px",
      "display": "block"
    },
    "div.shell > main[main].main > div.page-head > div.controls": {
      "display": "block",
      "margin": "0px 0px 0px auto"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"event kind\"": {
      "display": "inline-flex",
      "border-top": "1px solid rgb(51, 64, 76)",
      "border-right": "1px solid rgb(51, 64, 76)",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "border-left": "1px solid rgb(51, 64, 76)",
      "border-radius": "6px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"event kind\" > button[button].active \"all events\"": {
      "color": "rgb(255, 255, 255)",
      "font-family": "Arial",
      "font-size": "12px",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(58, 106, 145)",
      "padding": "4px 12px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"event kind\" > button[button] \"started\"": {
      "color": "rgb(139, 152, 165)",
      "font-family": "Arial",
      "font-size": "12px",
      "line-height": "normal",
      "display": "block",
      "border-left": "1px solid rgb(51, 64, 76)",
      "padding": "4px 12px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"event kind\" > button[button] \"approval needed\"": {
      "color": "rgb(139, 152, 165)",
      "font-family": "Arial",
      "font-size": "12px",
      "line-height": "normal",
      "display": "block",
      "border-left": "1px solid rgb(51, 64, 76)",
      "padding": "4px 12px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"event kind\" > button[button] \"stops\"": {
      "color": "rgb(139, 152, 165)",
      "font-family": "Arial",
      "font-size": "12px",
      "line-height": "normal",
      "display": "block",
      "border-left": "1px solid rgb(51, 64, 76)",
      "padding": "4px 12px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"event kind\" > button[button] \"aborted\"": {
      "color": "rgb(139, 152, 165)",
      "font-family": "Arial",
      "font-size": "12px",
      "line-height": "normal",
      "display": "block",
      "border-left": "1px solid rgb(51, 64, 76)",

{
  "page": "gamedays",
  "path": "/gamedays",
  "theme": "light",
  "width": 390,
  "height": 844,
  "elements": {
    "html": {
      "color": "rgb(27, 35, 41)",
      "font-family": "-apple-system, \"Segoe UI\", Inter, Roboto, sans-serif",
      "font-size": "14px",
      "font-weight": "400",
      "line-height": "1.5",
      "letter-spacing": "normal",
      "text-transform": "none",
      "visibility": "visible",
      "display": "block",
      "background-color": "rgb(244, 246, 248)"
    },
    "body": {
      "display": "block",
      "background-color": "rgb(244, 246, 248)"
    },
    "a[link].sr-only.skip-link \"Skip to main content\"": {
      "color": "rgb(31, 111, 178)",
      "display": "block"
    },
    "div.shell": {
      "display": "block",
      "grid-template-columns": "208px 1fr"
    },
    "div.shell > header[banner].topbar": {
      "display": "flex",
      "background-color": "rgb(255, 255, 255)",
      "border-bottom": "1px solid rgb(227, 232, 237)",
      "padding": "8px 16px"
    },
    "div.shell > header[banner].topbar > span.name": {
      "font-size": "17px",
      "font-weight": "700",
      "letter-spacing": "0.4px",
      "display": "block"
    },
    "div.shell > header[banner].topbar > button[button].btn \"Menu\"": {
      "font-family": "Arial",
      "font-size": "13px",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(233, 238, 242)",
      "border-top": "1px solid rgb(197, 206, 214)",
      "border-right": "1px solid rgb(197, 206, 214)",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "border-left": "1px solid rgb(197, 206, 214)",
      "border-radius": "6px",
      "padding": "6px 14px"
    },
    "div.shell > main[main].main": {
      "display": "block",
      "padding": "22px 16px 60px"
    },
    "div.shell > main[main].main > div.page-head": {
      "display": "flex",
      "margin": "0px 0px 18px",
      "gap": "14px"
    },
    "div.shell > main[main].main > div.page-head > h1[heading] \"GameDays\"": {
      "font-size": "19px",
      "font-weight": "600",
      "display": "block"
    },
    "div.shell > main[main].main > div.page-head > span.sub": {
      "color": "rgb(59, 71, 81)",
      "font-size": "12.5px",
      "display": "block"
    },
    "div.shell > main[main].main > div.panel": {
      "display": "block",
      "background-color": "rgb(255, 255, 255)",
      "border-top": "1px solid rgb(227, 232, 237)",
      "border-right": "1px solid rgb(227, 232, 237)",
      "border-bottom": "1px solid rgb(227, 232, 237)",
      "border-left": "1px solid rgb(227, 232, 237)",
      "border-radius": "6px",
      "padding": "14px 16px",
      "margin": "0px 0px 14px"
    },
    "div.shell > main[main].main > div.panel > table[table].data": {
      "font-size": "13px",
      "display": "table"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup]": {
      "display": "table-header-group"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row]": {
      "display": "table-row"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"TITLE\"": {
      "color": "rgb(59, 71, 81)",
      "font-size": "11.5px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "padding": "6px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"ID\"": {
      "color": "rgb(59, 71, 81)",
      "font-size": "11.5px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "padding": "6px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"REGISTERED\"": {
      "color": "rgb(59, 71, 81)",
      "font-size": "11.5px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "padding": "6px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"BY\"": {
      "color": "rgb(59, 71, 81)",
      "font-size": "11.5px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "padding": "6px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tbody": {
      "display": "table-row-group"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable": {
      "display": "table-row"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell] \"smoke campaign\"": {
      "display": "table-cell",
      "padding": "7px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell] \"smoke campaign\" > a[link].row-link \"smoke campaign\"": {
      "display": "inline"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell].mono \"gd-1\"": {
      "color": "rgb(59, 71, 81)",
      "font-family": "\"SF Mono\", \"JetBrains Mono\", ui-monospace, Menlo, Consolas, monospace",
      "font-size": "11.96px",
      "display": "table-cell",
      "padding": "7px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell] \"1d ago\"": {
      "display": "table-cell",
      "padding": "7px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell] \"operator\"": {
      "display": "table-cell",
      "padding": "7px 10px"
    },
    "div.shell > main[main].main > div.panel #2": {
      "display": "block",
      "background-color": "rgb(255, 255, 255)",
      "border-top": "1px solid rgb(227, 232, 237)",
      "border-right": "1px solid rgb(227, 232, 237)",
      "border-bottom": "1px solid rgb(227, 232, 237)",
      "border-left": "1px solid rgb(227, 232, 237)",
      "border-radius": "6px",
      "padding": "14px 16px"
    },
    "div.shell > main[main].main > div.panel #2 > h2[heading] \"REGISTER A GAMEDAY\"": {
      "color": "rgb(59, 71, 81)",
      "font-size": "12px",
      "font-weight": "600",
      "letter-spacing": "0.7px",
      "text-transform": "uppercase",
      "display": "block",
      "margin": "0px 0px 10px"
    },
    "div.shell > main[main].main > div.panel #2 > form[form]": {
      "display": "flex",
      "gap": "12px"
    },
    "div.shell > main[main].main > div.panel #2 > form[form] > label[LabelText]": {
      "color": "rgb(59, 71, 81)",
      "font-size": "12.5px",
      "display": "flex",
      "gap": "5px"
    },
    "div.shell > main[main].main > div.panel #2 > form[form] > label[LabelText] > textarea[textbox] \"Campaign TOON\"": {
      "color": "rgb(27, 35, 41)",
      "font-family": "\"SF Mono\", \"JetBrains Mono\", ui-monospace, Menlo, Consolas, monospace",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(255, 255, 255)",
      "border-top": "1px solid rgb(141, 149, 157)",
      "border-right": "1px solid rgb(141, 149, 157)",
      "border-bottom": "1px solid rgb(141, 149, 157)",
      "border-left": "1px solid rgb(141, 149, 157)",
      "border-radius": "5px",
      "padding": "8px 10px"
    },
    "div.shell > main[main].main > div.panel #2 > form[form] > label[LabelText] #2": {
      "color": "rgb(59, 71, 81)",
      "font-size": "12.5px",
      "display": "flex",
      "gap": "5px"
    },
    "div.shell > main[main].main > div.panel #2 > form[form] > label[LabelText] #2 > textarea[textbox] \"Experiment TOONs (JSON map of path → TOO…\"": {
      "color": "rgb(27, 35, 41)",
      "font-family": "\"SF Mono\", \"JetBrains Mono\", ui-monospace, Menlo, Consolas, monospace",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(255, 255, 255)",
      "border-top": "1px solid rgb(141, 149, 157)",
      "border-right": "1px solid rgb(141, 149, 157)",
      "border-bottom": "1px solid rgb(141, 149, 157)",
      "border-left": "1px solid rgb(141, 149, 157)",
      "border-radius": "5px",
      "padding": "8px 10px"
    },
    "div.shell > main[main].main > div.panel #2 > form[form] > div": {
      "display": "block",
      "margin": "4px 0px 0px"
    },
    "div.shell > main[main].main > div.panel #2 > form[form] > button[button].primary \"Validate and register\"": {
      "color": "rgb(255, 255, 255)",
      "font-family": "Arial",
      "font-size": "13px",
      "line-height": "normal",
      "display": "inline-block",
      "opacity": "0.5",
      "background-color": "rgb(74, 123, 164)",
      "border-top": "1px solid rgb(31, 111, 178)",
      "border-right": "1px solid rgb(31, 111, 178)",
      "border-bottom": "1px solid rgb(31, 111, 178)",
      "border-left": "1px solid rgb(31, 111, 178)",
      "border-radius": "5px",
      "padding": "7px 16px"
    },
    "div": {
      "display": "block"
    }
  }
}

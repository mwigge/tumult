{
  "page": "events",
  "path": "/events",
  "theme": "light",
  "width": 390,
  "height": 844,
  "elements": {
    "html": {
      "color": "rgb(27, 35, 41)",
      "font-family": "-apple-system, \"Segoe UI\", Inter, Roboto, sans-serif",
      "font-size": "14px",
      "font-weight": "400",
      "line-height": "1.5",
      "letter-spacing": "normal",
      "text-transform": "none",
      "visibility": "visible",
      "display": "block",
      "background-color": "rgb(244, 246, 248)"
    },
    "body": {
      "display": "block",
      "background-color": "rgb(244, 246, 248)"
    },
    "a[link].sr-only.skip-link \"Skip to main content\"": {
      "color": "rgb(31, 111, 178)",
      "display": "block"
    },
    "div.shell": {
      "display": "block",
      "grid-template-columns": "208px 1fr"
    },
    "div.shell > header[banner].topbar": {
      "display": "flex",
      "background-color": "rgb(255, 255, 255)",
      "border-bottom": "1px solid rgb(227, 232, 237)",
      "padding": "8px 16px"
    },
    "div.shell > header[banner].topbar > span.name": {
      "font-size": "17px",
      "font-weight": "700",
      "letter-spacing": "0.4px",
      "display": "block"
    },
    "div.shell > header[banner].topbar > button[button].btn \"Menu\"": {
      "font-family": "Arial",
      "font-size": "13px",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(233, 238, 242)",
      "border-top": "1px solid rgb(197, 206, 214)",
      "border-right": "1px solid rgb(197, 206, 214)",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "border-left": "1px solid rgb(197, 206, 214)",
      "border-radius": "6px",
      "padding": "6px 14px"
    },
    "div.shell > main[main].main": {
      "display": "block",
      "padding": "22px 16px 60px"
    },
    "div.shell > main[main].main > div.page-head": {
      "display": "flex",
      "margin": "0px 0px 18px",
      "gap": "14px"
    },
    "div.shell > main[main].main > div.page-head > h1[heading] \"Events\"": {
      "font-size": "19px",
      "font-weight": "600",
      "display": "block"
    },
    "div.shell > main[main].main > div.page-head > span.sub": {
      "color": "rgb(91, 103, 114)",
      "font-size": "12.5px",
      "display": "block"
    },
    "div.shell > main[main].main > div.page-head > div.controls": {
      "display": "block",
      "margin": "0px 0px 0px auto"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"event kind\"": {
      "display": "inline-flex",
      "border-top": "1px solid rgb(197, 206, 214)",
      "border-right": "1px solid rgb(197, 206, 214)",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "border-left": "1px solid rgb(197, 206, 214)",
      "border-radius": "5px",
      "gap": "normal 1px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"event kind\" > button[button].active \"all events\"": {
      "color": "rgb(255, 255, 255)",
      "font-family": "Arial",
      "font-size": "12.5px",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(74, 123, 164)",
      "padding": "5px 12px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"event kind\" > button[button] \"started\"": {
      "color": "rgb(91, 103, 114)",
      "font-family": "Arial",
      "font-size": "12.5px",
      "line-height": "normal",
      "display": "block",
      "box-shadow": "rgb(197, 206, 214) -1px 0px 0px 0px",
      "padding": "5px 12px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"event kind\" > button[button] \"approval needed\"": {
      "color": "rgb(91, 103, 114)",
      "font-family": "Arial",
      "font-size": "12.5px",
      "line-height": "normal",
      "display": "block",
      "box-shadow": "rgb(197, 206, 214) -1px 0px 0px 0px",
      "padding": "5px 12px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"event kind\" > button[button] \"stops\"": {
      "color": "rgb(91, 103, 114)",
      "font-family": "Arial",
      "font-size": "12.5px",
      "line-height": "normal",
      "display": "block",
      "box-shadow": "rgb(197, 206, 214) -1px 0px 0px 0px",
      "padding": "5px 12px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"event kind\" > button[button] \"aborted\"": {
      "color": "rgb(91, 103, 114)",
      "font-family": "Arial",
      "font-size": "12.5px",
      "line-height": "normal",
      "display": "block",
      "box-shadow": "rgb(197, 206, 214) -1px 0px 0px 0px",
      "padding": "5px 12px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"event kind\" > button[button] \"passed\"": {
      "color": "rgb(91, 103, 114)",
      "font-family": "Arial",
      "font-size": "12.5px",
      "line-height": "normal",
      "display": "block",
      "box-shadow": "rgb(197, 206, 214) -1px 0px 0px 0px",
      "padding": "5px 12px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"event kind\" > button[button] \"failed\"": {
      "color": "rgb(91, 103, 114)",
      "font-family": "Arial",
      "font-size": "12.5px",
      "line-height": "normal",
      "display": "block",
      "box-shadow": "rgb(197, 206, 214) -1px 0px 0px 0px",
      "padding": "5px 12px"
    },
    "div.shell > main[main].main > div.panel": {
      "display": "block",
      "background-color": "rgb(255, 255, 255)",
      "border-top": "1px solid rgb(227, 232, 237)",
      "border-right": "1px solid rgb(227, 232, 237)",
      "border-bottom": "1px solid rgb(227, 232, 237)",
      "border-left": "1px solid rgb(227, 232, 237)",
      "border-radius": "6px",
      "padding": "14px 16px"
    },
    "div.shell > main[main].main > div.panel > table[table].data": {
      "font-size": "13px",
      "display": "table"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup]": {
      "display": "table-header-group"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row]": {
      "display": "table-row"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"WHEN\"": {
      "color": "rgb(91, 103, 114)",
      "font-size": "11.5px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "padding": "6px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"EVENT\"": {
      "color": "rgb(91, 103, 114)",
      "font-size": "11.5px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "padding": "6px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"DEFINITION\"": {
      "color": "rgb(91, 103, 114)",
      "font-size": "11.5px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "padding": "6px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"RUN\"": {
      "color": "rgb(91, 103, 114)",
      "font-size": "11.5px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "padding": "6px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"ACTOR\"": {
      "color": "rgb(91, 103, 114)",
      "font-size": "11.5px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "padding": "6px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"DETAIL\"": {
      "color": "rgb(91, 103, 114)",
      "font-size": "11.5px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "padding": "6px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tbody": {
      "display": "table-row-group"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row]": {
      "display": "table-row"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row] > td[cell] \"1h ago\"": {
      "display": "table-cell",
      "border-bottom": "1px solid rgb(227, 232, 237)",
      "padding": "7px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row] > td[cell] \"started\"": {
      "display": "table-cell",
      "border-bottom": "1px solid rgb(227, 232, 237)",
      "padding": "7px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row] > td[cell] \"started\" > span.badge.neutral": {
      "color": "rgb(91, 103, 114)",
      "font-size": "11.5px",
      "font-weight": "600",
      "letter-spacing": "0.3px",
      "display": "inline-block",
      "background-color": "rgb(233, 238, 242)",
      "border-radius": "10px",
      "padding": "1px 9px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row] > td[cell] \"pg-failover\"": {
      "display": "table-cell",
      "border-bottom": "1px solid rgb(227, 232, 237)",
      "padding": "7px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row] > td[cell].mono \"run-1\"": {
      "color": "rgb(91, 103, 114)",
      "font-family": "\"SF Mono\", \"JetBrains Mono\", ui-monospace, Menlo, Consolas, monospace",
      "font-size": "11.96px",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(227, 232, 237)",
      "padding": "7px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row] > td[cell].mono \"run-1\" > a[link] \"run-1\"": {
      "color": "rgb(31, 111, 178)",
      "display": "inline"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row] > td[cell] \"operator\"": {
      "display": "table-cell",
      "border-bottom": "1px solid rgb(227, 232, 237)",
      "padding": "7px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row] > td[cell].dim": {
      "color": "rgb(91, 103, 114)",
      "font-size": "12px",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(227, 232, 237)",
      "padding": "7px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row] #2": {
      "display": "table-row"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row] #2 > td[cell] \"2h ago\"": {
      "display": "table-cell",
      "padding": "7px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row] #2 > td[cell] \"failed\"": {
      "display": "table-cell",

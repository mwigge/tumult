{
  "page": "metrics",
  "path": "/metrics?name=requests",
  "theme": "light",
  "width": 390,
  "height": 844,
  "elements": {
    "html": {
      "color": "rgb(27, 35, 41)",
      "font-family": "-apple-system, \"Segoe UI\", Inter, Roboto, sans-serif",
      "font-size": "13px",
      "font-weight": "400",
      "line-height": "1.5",
      "letter-spacing": "normal",
      "text-transform": "none",
      "visibility": "visible",
      "display": "block",
      "background-color": "rgb(244, 246, 248)"
    },
    "body": {
      "display": "block",
      "background-color": "rgb(244, 246, 248)"
    },
    "a[link].sr-only.skip-link \"Skip to main content\"": {
      "color": "rgb(31, 111, 178)",
      "display": "block"
    },
    "div.shell": {
      "display": "block",
      "grid-template-columns": "208px 1fr"
    },
    "div.shell > header[banner].topbar": {
      "display": "flex",
      "background-color": "rgb(255, 255, 255)",
      "border-bottom": "1px solid rgb(227, 232, 237)",
      "padding": "8px 16px"
    },
    "div.shell > header[banner].topbar > span.name": {
      "font-size": "18px",
      "font-weight": "700",
      "letter-spacing": "0.5px",
      "display": "block"
    },
    "div.shell > header[banner].topbar > button[button].btn \"Menu\"": {
      "font-family": "Arial",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(233, 238, 242)",
      "border-top": "1px solid rgb(197, 206, 214)",
      "border-right": "1px solid rgb(197, 206, 214)",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "border-left": "1px solid rgb(197, 206, 214)",
      "border-radius": "6px",
      "padding": "8px 16px"
    },
    "div.shell > main[main].main": {
      "display": "block",
      "padding": "24px 16px 60px"
    },
    "div.shell > main[main].main > div.page-head": {
      "display": "flex",
      "margin": "0px 0px 20px",
      "gap": "16px"
    },
    "div.shell > main[main].main > div.page-head > h1[heading] \"Metrics\"": {
      "font-size": "18px",
      "font-weight": "600",
      "display": "block"
    },
    "div.shell > main[main].main > div.page-head > span.badge.neutral": {
      "color": "rgb(59, 71, 81)",
      "font-size": "12px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "display": "block",
      "background-color": "rgb(233, 238, 242)",
      "border-radius": "999px",
      "padding": "2px 8px"
    },
    "div.shell > main[main].main > div.page-head > div.controls": {
      "display": "flex",
      "margin": "0px 0px 0px auto",
      "gap": "8px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > select[combobox] \"Metric\"": {
      "font-family": "Arial",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(255, 255, 255)",
      "border-top": "1px solid rgb(141, 149, 157)",
      "border-right": "1px solid rgb(141, 149, 157)",
      "border-bottom": "1px solid rgb(141, 149, 157)",
      "border-left": "1px solid rgb(141, 149, 157)",
      "border-radius": "6px",
      "padding": "8px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > select[combobox] \"Group by\"": {
      "font-family": "Arial",
      "line-height": "normal",
      "display": "block",
      "opacity": "0.7",
      "background-color": "rgb(255, 255, 255)",
      "border-top": "1px solid rgb(141, 149, 157)",
      "border-right": "1px solid rgb(141, 149, 157)",
      "border-bottom": "1px solid rgb(141, 149, 157)",
      "border-left": "1px solid rgb(141, 149, 157)",
      "border-radius": "6px",
      "padding": "8px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"chart type\"": {
      "display": "flex",
      "border-top": "1px solid rgb(197, 206, 214)",
      "border-right": "1px solid rgb(197, 206, 214)",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "border-left": "1px solid rgb(197, 206, 214)",
      "border-radius": "6px",
      "gap": "normal 1px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"chart type\" > button[button].active \"line\"": {
      "color": "rgb(255, 255, 255)",
      "font-family": "Arial",
      "font-size": "12px",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(74, 123, 164)",
      "padding": "4px 12px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"chart type\" > button[button] \"area\"": {
      "color": "rgb(59, 71, 81)",
      "font-family": "Arial",
      "font-size": "12px",
      "line-height": "normal",
      "display": "block",
      "box-shadow": "rgb(197, 206, 214) -1px 0px 0px 0px",
      "padding": "4px 12px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"chart type\" > button[button] \"bar\"": {
      "color": "rgb(59, 71, 81)",
      "font-family": "Arial",
      "font-size": "12px",
      "line-height": "normal",
      "display": "block",
      "box-shadow": "rgb(197, 206, 214) -1px 0px 0px 0px",
      "padding": "4px 12px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > select[combobox] \"Interval\"": {
      "font-family": "Arial",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(255, 255, 255)",
      "border-top": "1px solid rgb(141, 149, 157)",
      "border-right": "1px solid rgb(141, 149, 157)",
      "border-bottom": "1px solid rgb(141, 149, 157)",
      "border-left": "1px solid rgb(141, 149, 157)",
      "border-radius": "6px",
      "padding": "8px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"time range\"": {
      "display": "flex",
      "border-top": "1px solid rgb(197, 206, 214)",
      "border-right": "1px solid rgb(197, 206, 214)",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "border-left": "1px solid rgb(197, 206, 214)",
      "border-radius": "6px",
      "gap": "normal 1px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"time range\" > button[button].active \"24h\"": {
      "color": "rgb(255, 255, 255)",
      "font-family": "Arial",
      "font-size": "12px",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(74, 123, 164)",
      "padding": "4px 12px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"time range\" > button[button] \"7d\"": {
      "color": "rgb(59, 71, 81)",
      "font-family": "Arial",
      "font-size": "12px",
      "line-height": "normal",
      "display": "block",
      "box-shadow": "rgb(197, 206, 214) -1px 0px 0px 0px",
      "padding": "4px 12px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"time range\" > button[button] \"14d\"": {
      "color": "rgb(59, 71, 81)",
      "font-family": "Arial",
      "font-size": "12px",
      "line-height": "normal",
      "display": "block",
      "box-shadow": "rgb(197, 206, 214) -1px 0px 0px 0px",
      "padding": "4px 12px"
    },
    "div.shell > main[main].main > div.panel": {
      "display": "block",
      "background-color": "rgb(255, 255, 255)",
      "border-top": "1px solid rgb(227, 232, 237)",
      "border-right": "1px solid rgb(227, 232, 237)",
      "border-bottom": "1px solid rgb(227, 232, 237)",
      "border-left": "1px solid rgb(227, 232, 237)",
      "border-radius": "6px",
      "padding": "16px"
    },
    "div.shell > main[main].main > div.panel > div[image] \"Metric values over time\"": {
      "display": "block"
    },
    "div.shell > main[main].main > div.panel > div[image] \"Metric values over time\" > div": {
      "display": "block"
    },
    "div.shell > main[main].main > div.panel > div[image] \"Metric values over time\" > canvas[Canvas]": {
      "display": "block"
    },
    "div.shell > main[main].main > div.panel > div[image] \"Metric values over time\" > div #2": {
      "display": "block"
    },
    "div": {
      "display": "block"
    }
  }
}

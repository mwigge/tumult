{
  "page": "reports",
  "path": "/reports",
  "theme": "light",
  "width": 390,
  "height": 844,
  "elements": {
    "html": {
      "color": "rgb(27, 35, 41)",
      "font-family": "-apple-system, \"Segoe UI\", Inter, Roboto, sans-serif",
      "font-size": "13px",
      "font-weight": "400",
      "line-height": "1.5",
      "letter-spacing": "normal",
      "text-transform": "none",
      "visibility": "visible",
      "display": "block",
      "background-color": "rgb(244, 246, 248)"
    },
    "body": {
      "display": "block",
      "background-color": "rgb(244, 246, 248)"
    },
    "a[link].sr-only.skip-link \"Skip to main content\"": {
      "color": "rgb(31, 111, 178)",
      "display": "block"
    },
    "div.shell": {
      "display": "block",
      "grid-template-columns": "208px 1fr"
    },
    "div.shell > header[banner].topbar": {
      "display": "flex",
      "background-color": "rgb(255, 255, 255)",
      "border-bottom": "1px solid rgb(227, 232, 237)",
      "padding": "8px 16px"
    },
    "div.shell > header[banner].topbar > span.name": {
      "font-size": "18px",
      "font-weight": "700",
      "letter-spacing": "0.5px",
      "display": "block"
    },
    "div.shell > header[banner].topbar > button[button].btn \"Menu\"": {
      "font-family": "Arial",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(233, 238, 242)",
      "border-top": "1px solid rgb(197, 206, 214)",
      "border-right": "1px solid rgb(197, 206, 214)",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "border-left": "1px solid rgb(197, 206, 214)",
      "border-radius": "6px",
      "padding": "8px 16px"
    },
    "div.shell > main[main].main": {
      "display": "block",
      "padding": "24px 16px 60px"
    },
    "div.shell > main[main].main > div.page-head": {
      "display": "flex",
      "margin": "0px 0px 20px",
      "gap": "16px"
    },
    "div.shell > main[main].main > div.page-head > h1[heading] \"Reports\"": {
      "font-size": "18px",
      "font-weight": "600",
      "display": "block"
    },
    "div.shell > main[main].main > div.page-head > span.sub": {
      "color": "rgb(91, 103, 114)",
      "font-size": "12px",
      "display": "block"
    },
    "div.shell > main[main].main > div.panel": {
      "display": "block",
      "background-color": "rgb(255, 255, 255)",
      "border-top": "1px solid rgb(227, 232, 237)",
      "border-right": "1px solid rgb(227, 232, 237)",
      "border-bottom": "1px solid rgb(227, 232, 237)",
      "border-left": "1px solid rgb(227, 232, 237)",
      "border-radius": "6px",
      "padding": "16px",
      "margin": "0px 0px 16px"
    },
    "div.shell > main[main].main > div.panel > h2[heading] \"COMPLIANCE REPORTS\"": {
      "color": "rgb(91, 103, 114)",
      "font-size": "12px",
      "font-weight": "600",
      "letter-spacing": "0.6px",
      "text-transform": "uppercase",
      "display": "block",
      "margin": "0px 0px 12px"
    },
    "div.shell > main[main].main > div.panel > div.genbar": {
      "display": "flex",
      "gap": "12px"
    },
    "div.shell > main[main].main > div.panel > div.genbar > select[combobox] \"template\"": {
      "font-family": "Arial",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(255, 255, 255)",
      "border-top": "1px solid rgb(141, 149, 157)",
      "border-right": "1px solid rgb(141, 149, 157)",
      "border-bottom": "1px solid rgb(141, 149, 157)",
      "border-left": "1px solid rgb(141, 149, 157)",
      "border-radius": "6px",
      "padding": "8px"
    },
    "div.shell > main[main].main > div.panel > div.genbar > select[combobox] \"period\"": {
      "font-family": "Arial",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(255, 255, 255)",
      "border-top": "1px solid rgb(141, 149, 157)",
      "border-right": "1px solid rgb(141, 149, 157)",
      "border-bottom": "1px solid rgb(141, 149, 157)",
      "border-left": "1px solid rgb(141, 149, 157)",
      "border-radius": "6px",
      "padding": "8px"
    },
    "div.shell > main[main].main > div.panel > div.genbar > button[button].primary \"Generate\"": {
      "color": "rgb(255, 255, 255)",
      "font-family": "Arial",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(74, 123, 164)",
      "border-top": "1px solid rgb(31, 111, 178)",
      "border-right": "1px solid rgb(31, 111, 178)",
      "border-bottom": "1px solid rgb(31, 111, 178)",
      "border-left": "1px solid rgb(31, 111, 178)",
      "border-radius": "6px",
      "padding": "8px 16px"
    },
    "div.shell > main[main].main > div.panel > table[table].data": {
      "display": "table",
      "margin": "12px 0px 0px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup]": {
      "display": "table-header-group"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row]": {
      "display": "table-row"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"DOCUMENT\"": {
      "color": "rgb(91, 103, 114)",
      "font-size": "11px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"TYPE\"": {
      "color": "rgb(91, 103, 114)",
      "font-size": "11px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"CREATED\"": {
      "color": "rgb(91, 103, 114)",
      "font-size": "11px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"SIZE\"": {
      "color": "rgb(91, 103, 114)",
      "font-size": "11px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"SHA-256\"": {
      "color": "rgb(91, 103, 114)",
      "font-size": "11px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader]": {
      "color": "rgb(91, 103, 114)",
      "font-size": "11px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tbody": {
      "display": "table-row-group"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable": {
      "display": "table-row"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell].mono \"doc-1\"": {
      "font-family": "\"SF Mono\", \"JetBrains Mono\", ui-monospace, Menlo, Consolas, monospace",
      "font-size": "11.96px",
      "display": "table-cell",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell].mono \"doc-1\" > button[button].row-button \"doc-1\"": {
      "display": "inline-block"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell] \"R1\"": {
      "display": "table-cell",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell] \"R1\" > span.badge.neutral": {
      "color": "rgb(91, 103, 114)",
      "font-size": "12px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "display": "inline-block",
      "background-color": "rgb(233, 238, 242)",
      "border-radius": "999px",
      "padding": "2px 8px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell] \"11/14/2026, 11:00:00 AM\"": {
      "display": "table-cell",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell].mono \"20.0 KB\"": {
      "font-family": "\"SF Mono\", \"JetBrains Mono\", ui-monospace, Menlo, Consolas, monospace",
      "font-size": "11.96px",
      "display": "table-cell",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell].mono.hash \"dddddddddd…\"": {
      "color": "rgb(91, 103, 114)",
      "font-family": "\"SF Mono\", \"JetBrains Mono\", ui-monospace, Menlo, Consolas, monospace",
      "font-size": "12px",
      "display": "table-cell",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell] \"PDF ↗\"": {
      "display": "table-cell",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell] \"PDF ↗\" > a[link] \"PDF ↗\"": {
      "color": "rgb(31, 111, 178)",
      "display": "inline"
    },
    "div.shell > main[main].main > div.panel #2": {
      "display": "block",
      "background-color": "rgb(255, 255, 255)",
      "border-top": "1px solid rgb(227, 232, 237)",
      "border-right": "1px solid rgb(227, 232, 237)",
      "border-bottom": "1px solid rgb(227, 232, 237)",
      "border-left": "1px solid rgb(227, 232, 237)",
      "border-radius": "6px",
      "padding": "16px"
    },
    "div.shell > main[main].main > div.panel #2 > h2[heading] \"QUICK DIGESTS\"": {
      "color": "rgb(91, 103, 114)",
      "font-size": "12px",
      "font-weight": "600",
      "letter-spacing": "0.6px",
      "text-transform": "uppercase",
      "display": "block",
      "margin": "0px 0px 12px"
    },
    "div.shell > main[main].main > div.panel #2 > div.genbar": {
      "display": "flex",
      "gap": "12px"
    },
    "div.shell > main[main].main > div.panel #2 > div.genbar > select[combobox] \"metric\"": {
      "font-family": "Arial",
      "line-height": "normal",
      "display": "block",
      "opacity": "0.7",
      "background-color": "rgb(255, 255, 255)",
      "border-top": "1px solid rgb(141, 149, 157)",
      "border-right": "1px solid rgb(141, 149, 157)",
      "border-bottom": "1px solid rgb(141, 149, 157)",
      "border-left": "1px solid rgb(141, 149, 157)",
      "border-radius": "6px",
      "padding": "8px"
    },
    "div.shell > main[main].main > div.panel #2 > div.genbar > button[button].primary \"Generate\"": {
      "color": "rgb(255, 255, 255)",
      "font-family": "Arial",
      "line-height": "normal",
      "display": "block",
      "opacity": "0.5",
      "background-color": "rgb(74, 123, 164)",
      "border-top": "1px solid rgb(31, 111, 178)",
      "border-right": "1px solid rgb(31, 111, 178)",
      "border-bottom": "1px solid rgb(31, 111, 178)",
      "border-left": "1px solid rgb(31, 111, 178)",
      "border-radius": "6px",
      "padding": "8px 16px"
    },
    "div": {
      "display": "block"
    }
  }
}

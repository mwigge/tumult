{
  "page": "metrics",
  "path": "/metrics?name=requests",
  "theme": "dark",
  "width": 390,
  "height": 844,
  "elements": {
    "html": {
      "color": "rgb(216, 222, 228)",
      "font-family": "-apple-system, \"Segoe UI\", Inter, Roboto, sans-serif",
      "font-size": "13px",
      "font-weight": "400",
      "line-height": "1.5",
      "letter-spacing": "normal",
      "text-transform": "none",
      "visibility": "visible",
      "display": "block",
      "background-color": "rgb(11, 14, 17)"
    },
    "body": {
      "display": "block",
      "background-color": "rgb(11, 14, 17)"
    },
    "a[link].sr-only.skip-link \"Skip to main content\"": {
      "color": "rgb(94, 177, 239)",
      "display": "block"
    },
    "div.shell": {
      "display": "block",
      "grid-template-columns": "208px 1fr"
    },
    "div.shell > header[banner].topbar": {
      "display": "flex",
      "background-color": "rgb(17, 22, 27)",
      "border-bottom": "1px solid rgb(36, 45, 54)",
      "padding": "8px 16px"
    },
    "div.shell > header[banner].topbar > span.name": {
      "font-size": "18px",
      "font-weight": "700",
      "letter-spacing": "0.5px",
      "display": "block"
    },
    "div.shell > header[banner].topbar > button[button].btn \"Menu\"": {
      "font-family": "Arial",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(28, 36, 44)",
      "border-top": "1px solid rgb(51, 64, 76)",
      "border-right": "1px solid rgb(51, 64, 76)",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "border-left": "1px solid rgb(51, 64, 76)",
      "border-radius": "6px",
      "padding": "8px 16px"
    },
    "div.shell > main[main].main": {
      "display": "block",
      "padding": "24px 16px 60px"
    },
    "div.shell > main[main].main > div.page-head": {
      "display": "flex",
      "margin": "0px 0px 20px",
      "gap": "16px"
    },
    "div.shell > main[main].main > div.page-head > h1[heading] \"Metrics\"": {
      "font-size": "18px",
      "font-weight": "600",
      "display": "block"
    },
    "div.shell > main[main].main > div.page-head > span.badge.neutral": {
      "color": "rgb(139, 152, 165)",
      "font-size": "12px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "display": "block",
      "background-color": "rgb(28, 36, 44)",
      "border-radius": "999px",
      "padding": "2px 8px"
    },
    "div.shell > main[main].main > div.page-head > div.controls": {
      "display": "flex",
      "margin": "0px 0px 0px auto",
      "gap": "8px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > select[combobox] \"Metric\"": {
      "font-family": "Arial",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(17, 22, 27)",
      "border-top": "1px solid rgb(97, 109, 121)",
      "border-right": "1px solid rgb(97, 109, 121)",
      "border-bottom": "1px solid rgb(97, 109, 121)",
      "border-left": "1px solid rgb(97, 109, 121)",
      "border-radius": "6px",
      "padding": "8px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > select[combobox] \"Group by\"": {
      "font-family": "Arial",
      "line-height": "normal",
      "display": "block",
      "opacity": "0.7",
      "background-color": "rgb(17, 22, 27)",
      "border-top": "1px solid rgb(97, 109, 121)",
      "border-right": "1px solid rgb(97, 109, 121)",
      "border-bottom": "1px solid rgb(97, 109, 121)",
      "border-left": "1px solid rgb(97, 109, 121)",
      "border-radius": "6px",
      "padding": "8px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"chart type\"": {
      "display": "flex",
      "border-top": "1px solid rgb(51, 64, 76)",
      "border-right": "1px solid rgb(51, 64, 76)",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "border-left": "1px solid rgb(51, 64, 76)",
      "border-radius": "6px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"chart type\" > button[button].active \"line\"": {
      "color": "rgb(255, 255, 255)",
      "font-family": "Arial",
      "font-size": "12px",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(58, 106, 145)",
      "padding": "4px 12px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"chart type\" > button[button] \"area\"": {
      "color": "rgb(139, 152, 165)",
      "font-family": "Arial",
      "font-size": "12px",
      "line-height": "normal",
      "display": "block",
      "border-left": "1px solid rgb(51, 64, 76)",
      "padding": "4px 12px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"chart type\" > button[button] \"bar\"": {
      "color": "rgb(139, 152, 165)",
      "font-family": "Arial",
      "font-size": "12px",
      "line-height": "normal",
      "display": "block",
      "border-left": "1px solid rgb(51, 64, 76)",
      "padding": "4px 12px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > select[combobox] \"Interval\"": {
      "font-family": "Arial",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(17, 22, 27)",
      "border-top": "1px solid rgb(97, 109, 121)",
      "border-right": "1px solid rgb(97, 109, 121)",
      "border-bottom": "1px solid rgb(97, 109, 121)",
      "border-left": "1px solid rgb(97, 109, 121)",
      "border-radius": "6px",
      "padding": "8px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"time range\"": {
      "display": "flex",
      "border-top": "1px solid rgb(51, 64, 76)",
      "border-right": "1px solid rgb(51, 64, 76)",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "border-left": "1px solid rgb(51, 64, 76)",
      "border-radius": "6px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"time range\" > button[button].active \"24h\"": {
      "color": "rgb(255, 255, 255)",
      "font-family": "Arial",
      "font-size": "12px",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(58, 106, 145)",
      "padding": "4px 12px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"time range\" > button[button] \"7d\"": {
      "color": "rgb(139, 152, 165)",
      "font-family": "Arial",
      "font-size": "12px",
      "line-height": "normal",
      "display": "block",
      "border-left": "1px solid rgb(51, 64, 76)",
      "padding": "4px 12px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"time range\" > button[button] \"14d\"": {
      "color": "rgb(139, 152, 165)",
      "font-family": "Arial",
      "font-size": "12px",
      "line-height": "normal",
      "display": "block",
      "border-left": "1px solid rgb(51, 64, 76)",
      "padding": "4px 12px"
    },
    "div.shell > main[main].main > div.panel": {
      "display": "block",
      "background-color": "rgb(21, 27, 33)",
      "border-top": "1px solid rgb(36, 45, 54)",
      "border-right": "1px solid rgb(36, 45, 54)",
      "border-bottom": "1px solid rgb(36, 45, 54)",
      "border-left": "1px solid rgb(36, 45, 54)",
      "border-radius": "6px",
      "padding": "16px"
    },
    "div.shell > main[main].main > div.panel > div[image] \"Metric values over time\"": {
      "display": "block"
    },
    "div.shell > main[main].main > div.panel > div[image] \"Metric values over time\" > div": {
      "display": "block"
    },
    "div.shell > main[main].main > div.panel > div[image] \"Metric values over time\" > canvas[Canvas]": {
      "display": "block"
    },
    "div.shell > main[main].main > div.panel > div[image] \"Metric values over time\" > div #2": {
      "display": "block"
    },
    "div": {
      "display": "block"
    }
  }
}

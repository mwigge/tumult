      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"REQUESTED\"": {
      "color": "rgb(59, 71, 81)",
      "font-size": "11px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"EXPIRES\"": {
      "color": "rgb(59, 71, 81)",
      "font-size": "11px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"QUORUM\"": {
      "color": "rgb(59, 71, 81)",
      "font-size": "11px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"NOTE\"": {
      "color": "rgb(59, 71, 81)",
      "font-size": "11px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] #2": {
      "color": "rgb(59, 71, 81)",
      "font-size": "11px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tbody": {
      "display": "table-row-group"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable": {
      "display": "table-row"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell] \"▸\"": {
      "color": "rgb(97, 109, 121)",
      "display": "table-cell",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell] \"pg-failover\"": {
      "display": "table-cell",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell] \"pg-failover\" > button[button].row-button \"pg-failover\"": {
      "display": "inline-block"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell].mono \"run-9\"": {
      "color": "rgb(59, 71, 81)",
      "font-family": "\"SF Mono\", \"JetBrains Mono\", ui-monospace, Menlo, Consolas, monospace",
      "font-size": "11.96px",
      "display": "table-cell",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell].mono \"run-9\" > a[link] \"run-9\"": {
      "color": "rgb(31, 111, 178)",
      "display": "inline"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell] \"T2\"": {
      "display": "table-cell",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell] \"T2\" > span.badge.warn": {
      "color": "rgb(171, 77, 4)",
      "font-size": "12px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "display": "inline-block",
      "background-color": "color(srgb 0.953882 0.902274 0.862196)",
      "border-radius": "999px",
      "padding": "2px 8px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell] \"production\"": {
      "display": "table-cell",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell] \"operator · 1h ago\"": {
      "display": "table-cell",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell].mono \"24h 0m\"": {
      "font-family": "\"SF Mono\", \"JetBrains Mono\", ui-monospace, Menlo, Consolas, monospace",
      "font-size": "11.96px",
      "display": "table-cell",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell].mono \"1/2\"": {
      "font-family": "\"SF Mono\", \"JetBrains Mono\", ui-monospace, Menlo, Consolas, monospace",
      "font-size": "11.96px",
      "display": "table-cell",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell] \"Decision note\"": {
      "display": "table-cell",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell] \"Decision note\" > input[textbox] \"Decision note\"": {
      "font-family": "Arial",
      "line-height": "normal",
      "display": "inline-block",
      "background-color": "rgb(255, 255, 255)",
      "border-top": "1px solid rgb(141, 149, 157)",
      "border-right": "1px solid rgb(141, 149, 157)",
      "border-bottom": "1px solid rgb(141, 149, 157)",
      "border-left": "1px solid rgb(141, 149, 157)",
      "border-radius": "6px",
      "padding": "8px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell].actions \"Approve Reject\"": {
      "display": "flex",
      "padding": "8px 12px",
      "gap": "8px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell].actions \"Approve Reject\" > button[button].btn \"Approve\"": {
      "font-family": "Arial",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(233, 238, 242)",
      "border-top": "1px solid rgb(197, 206, 214)",
      "border-right": "1px solid rgb(197, 206, 214)",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "border-left": "1px solid rgb(197, 206, 214)",
      "border-radius": "6px",
      "padding": "8px 16px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell].actions \"Approve Reject\" > button[button].btn.danger \"Reject\"": {
      "color": "rgb(190, 55, 41)",
      "font-family": "Arial",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(233, 238, 242)",
      "border-top": "1px solid rgb(190, 55, 41)",
      "border-right": "1px solid rgb(190, 55, 41)",
      "border-bottom": "1px solid rgb(190, 55, 41)",
      "border-left": "1px solid rgb(190, 55, 41)",
      "border-radius": "6px",
      "padding": "8px 16px"
    },
    "div": {
      "display": "block"

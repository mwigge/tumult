{
  "page": "approvals",
  "path": "/approvals",
  "theme": "light",
  "width": 390,
  "height": 844,
  "elements": {
    "html": {
      "color": "rgb(27, 35, 41)",
      "font-family": "-apple-system, \"Segoe UI\", Inter, Roboto, sans-serif",
      "font-size": "13px",
      "font-weight": "400",
      "line-height": "1.5",
      "letter-spacing": "normal",
      "text-transform": "none",
      "visibility": "visible",
      "display": "block",
      "background-color": "rgb(244, 246, 248)"
    },
    "body": {
      "display": "block",
      "background-color": "rgb(244, 246, 248)"
    },
    "a[link].sr-only.skip-link \"Skip to main content\"": {
      "color": "rgb(31, 111, 178)",
      "display": "block"
    },
    "div.shell": {
      "display": "block",
      "grid-template-columns": "208px 1fr"
    },
    "div.shell > header[banner].topbar": {
      "display": "flex",
      "background-color": "rgb(255, 255, 255)",
      "border-bottom": "1px solid rgb(227, 232, 237)",
      "padding": "8px 16px"
    },
    "div.shell > header[banner].topbar > span.name": {
      "font-size": "18px",
      "font-weight": "700",
      "letter-spacing": "0.5px",
      "display": "block"
    },
    "div.shell > header[banner].topbar > button[button].btn \"Menu\"": {
      "font-family": "Arial",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(233, 238, 242)",
      "border-top": "1px solid rgb(197, 206, 214)",
      "border-right": "1px solid rgb(197, 206, 214)",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "border-left": "1px solid rgb(197, 206, 214)",
      "border-radius": "6px",
      "padding": "8px 16px"
    },
    "div.shell > main[main].main": {
      "display": "block",
      "padding": "24px 16px 60px"
    },
    "div.shell > main[main].main > div.page-head": {
      "display": "flex",
      "margin": "0px 0px 20px",
      "gap": "16px"
    },
    "div.shell > main[main].main > div.page-head > h1[heading] \"Approvals\"": {
      "font-size": "18px",
      "font-weight": "600",
      "display": "block"
    },
    "div.shell > main[main].main > div.page-head > span.sub": {
      "color": "rgb(59, 71, 81)",
      "font-size": "12px",
      "display": "block"
    },
    "div.shell > main[main].main > div.panel": {
      "display": "block",
      "background-color": "rgb(255, 255, 255)",
      "border-top": "1px solid rgb(227, 232, 237)",
      "border-right": "1px solid rgb(227, 232, 237)",
      "border-bottom": "1px solid rgb(227, 232, 237)",
      "border-left": "1px solid rgb(227, 232, 237)",
      "border-radius": "6px",
      "padding": "16px"
    },
    "div.shell > main[main].main > div.panel > table[table].data": {
      "display": "table"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup]": {
      "display": "table-header-group"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row]": {
      "display": "table-row"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader]": {
      "color": "rgb(59, 71, 81)",
      "font-size": "11px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"DEFINITION\"": {
      "color": "rgb(59, 71, 81)",
      "font-size": "11px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "padding": "8px 12px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"RUN\"": {
      "color": "rgb(59, 71, 81)",
      "font-size": "11px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(197, 206, 214)",
      "padding": "8px 12px"
    },

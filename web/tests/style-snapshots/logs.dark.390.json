{
  "page": "logs",
  "path": "/logs",
  "theme": "dark",
  "width": 390,
  "height": 844,
  "elements": {
    "html": {
      "color": "rgb(216, 222, 228)",
      "font-family": "-apple-system, \"Segoe UI\", Inter, Roboto, sans-serif",
      "font-size": "14px",
      "font-weight": "400",
      "line-height": "1.5",
      "letter-spacing": "normal",
      "text-transform": "none",
      "visibility": "visible",
      "display": "block",
      "background-color": "rgb(11, 14, 17)"
    },
    "body": {
      "display": "block",
      "background-color": "rgb(11, 14, 17)"
    },
    "div.shell": {
      "display": "block",
      "grid-template-columns": "208px 1fr"
    },
    "div.shell > header[banner].topbar": {
      "display": "flex",
      "background-color": "rgb(17, 22, 27)",
      "border-bottom": "1px solid rgb(36, 45, 54)",
      "padding": "8px 16px"
    },
    "div.shell > header[banner].topbar > span.name": {
      "font-size": "17px",
      "font-weight": "700",
      "letter-spacing": "0.4px",
      "display": "block"
    },
    "div.shell > header[banner].topbar > button[button].btn \"Menu\"": {
      "font-family": "Arial",
      "font-size": "13px",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(28, 36, 44)",
      "border-top": "1px solid rgb(51, 64, 76)",
      "border-right": "1px solid rgb(51, 64, 76)",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "border-left": "1px solid rgb(51, 64, 76)",
      "border-radius": "6px",
      "padding": "6px 14px"
    },
    "div.shell > main[main].main": {
      "display": "block",
      "padding": "22px 16px 60px"
    },
    "div.shell > main[main].main > div.page-head": {
      "display": "flex",
      "margin": "0px 0px 18px",
      "gap": "14px"
    },
    "div.shell > main[main].main > div.page-head > h1[heading] \"Logs\"": {
      "font-size": "19px",
      "font-weight": "600",
      "display": "block"
    },
    "div.shell > main[main].main > div.page-head > span.sub": {
      "color": "rgb(139, 152, 165)",
      "font-size": "12.5px",
      "display": "block"
    },
    "div.shell > main[main].main > div.page-head > div.controls": {
      "display": "flex",
      "margin": "0px 0px 0px auto",
      "gap": "8px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > input[searchbox] \"search body…\"": {
      "font-family": "Arial",
      "font-size": "13px",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(17, 22, 27)",
      "border-top": "1px solid rgb(51, 64, 76)",
      "border-right": "1px solid rgb(51, 64, 76)",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "border-left": "1px solid rgb(51, 64, 76)",
      "border-radius": "5px",
      "padding": "6px 9px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > select[combobox]": {
      "font-family": "Arial",
      "font-size": "13px",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(17, 22, 27)",
      "border-top": "1px solid rgb(51, 64, 76)",
      "border-right": "1px solid rgb(51, 64, 76)",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "border-left": "1px solid rgb(51, 64, 76)",
      "border-radius": "5px",
      "padding": "6px 9px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > input[searchbox] \"service…\"": {
      "font-family": "Arial",
      "font-size": "13px",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(17, 22, 27)",
      "border-top": "1px solid rgb(51, 64, 76)",
      "border-right": "1px solid rgb(51, 64, 76)",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "border-left": "1px solid rgb(51, 64, 76)",
      "border-radius": "5px",
      "padding": "6px 9px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"time range\"": {
      "display": "flex",
      "border-top": "1px solid rgb(51, 64, 76)",
      "border-right": "1px solid rgb(51, 64, 76)",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "border-left": "1px solid rgb(51, 64, 76)",
      "border-radius": "5px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"time range\" > button[button].active \"24h\"": {
      "color": "rgb(255, 255, 255)",
      "font-family": "Arial",
      "font-size": "12.5px",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(45, 93, 132)",
      "padding": "5px 12px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"time range\" > button[button] \"7d\"": {
      "color": "rgb(139, 152, 165)",
      "font-family": "Arial",
      "font-size": "12.5px",
      "line-height": "normal",
      "display": "block",
      "border-left": "1px solid rgb(51, 64, 76)",
      "padding": "5px 12px"
    },
    "div.shell > main[main].main > div.page-head > div.controls > div[group].seg \"time range\" > button[button] \"14d\"": {
      "color": "rgb(139, 152, 165)",
      "font-family": "Arial",
      "font-size": "12.5px",
      "line-height": "normal",
      "display": "block",
      "border-left": "1px solid rgb(51, 64, 76)",
      "padding": "5px 12px"
    },
    "div.shell > main[main].main > div.panel": {
      "display": "block",
      "background-color": "rgb(21, 27, 33)",
      "border-top": "1px solid rgb(36, 45, 54)",
      "border-right": "1px solid rgb(36, 45, 54)",
      "border-bottom": "1px solid rgb(36, 45, 54)",
      "border-left": "1px solid rgb(36, 45, 54)",
      "border-radius": "6px",
      "padding": "14px 16px"
    },
    "div.shell > main[main].main > div.panel > div[image] \"Log volume by severity\"": {
      "display": "block"
    },
    "div.shell > main[main].main > div.panel > div[image] \"Log volume by severity\" > div": {
      "display": "block"
    },
    "div.shell > main[main].main > div.panel > div[image] \"Log volume by severity\" > canvas[Canvas]": {
      "display": "block"
    },
    "div.shell > main[main].main > div.panel > div[image] \"Log volume by severity\" > div #2": {
      "display": "block"
    },
    "div.shell > main[main].main > div.panel #2": {
      "display": "block",
      "background-color": "rgb(21, 27, 33)",
      "border-top": "1px solid rgb(36, 45, 54)",
      "border-right": "1px solid rgb(36, 45, 54)",
      "border-bottom": "1px solid rgb(36, 45, 54)",
      "border-left": "1px solid rgb(36, 45, 54)",
      "border-radius": "6px",
      "padding": "14px 16px"
    },
    "div.shell > main[main].main > div.panel #2 > div.state": {
      "color": "rgb(139, 152, 165)",
      "font-size": "13px",
      "display": "block",
      "padding": "28px"
    },
    "div": {
      "display": "block"
    }
  }
}

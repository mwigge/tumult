{
  "page": "author",
  "path": "/author",
  "theme": "dark",
  "width": 390,
  "height": 844,
  "elements": {
    "html": {
      "color": "rgb(216, 222, 228)",
      "font-family": "-apple-system, \"Segoe UI\", Inter, Roboto, sans-serif",
      "font-size": "14px",
      "font-weight": "400",
      "line-height": "1.5",
      "letter-spacing": "normal",
      "text-transform": "none",
      "visibility": "visible",
      "display": "block",
      "background-color": "rgb(11, 14, 17)"
    },
    "body": {
      "display": "block",
      "background-color": "rgb(11, 14, 17)"
    },
    "a[link].sr-only.skip-link \"Skip to main content\"": {
      "color": "rgb(94, 177, 239)",
      "display": "block"
    },
    "div.shell": {
      "display": "block",
      "grid-template-columns": "208px 1fr"
    },
    "div.shell > header[banner].topbar": {
      "display": "flex",
      "background-color": "rgb(17, 22, 27)",
      "border-bottom": "1px solid rgb(36, 45, 54)",
      "padding": "8px 16px"
    },
    "div.shell > header[banner].topbar > span.name": {
      "font-size": "17px",
      "font-weight": "700",
      "letter-spacing": "0.4px",
      "display": "block"
    },
    "div.shell > header[banner].topbar > button[button].btn \"Menu\"": {
      "font-family": "Arial",
      "font-size": "13px",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(28, 36, 44)",
      "border-top": "1px solid rgb(51, 64, 76)",
      "border-right": "1px solid rgb(51, 64, 76)",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "border-left": "1px solid rgb(51, 64, 76)",
      "border-radius": "6px",
      "padding": "6px 14px"
    },
    "div.shell > main[main].main": {
      "display": "block",
      "padding": "22px 16px 60px"
    },
    "div.shell > main[main].main > div.page-head": {
      "display": "flex",
      "margin": "0px 0px 18px",
      "gap": "14px"
    },
    "div.shell > main[main].main > div.page-head > h1[heading] \"Author an experiment\"": {
      "font-size": "19px",
      "font-weight": "600",
      "display": "block"
    },
    "div.shell > main[main].main > div.page-head > span.sub": {
      "color": "rgb(139, 152, 165)",
      "font-size": "12.5px",
      "display": "block"
    },
    "div.shell > main[main].main > div.filters": {
      "display": "flex",
      "margin": "0px 0px 14px",
      "gap": "10px"
    },
    "div.shell > main[main].main > div.filters > input[searchbox] \"Search actions\"": {
      "font-family": "Arial",
      "font-size": "13px",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(17, 22, 27)",
      "border-top": "1px solid rgb(97, 109, 121)",
      "border-right": "1px solid rgb(97, 109, 121)",
      "border-bottom": "1px solid rgb(97, 109, 121)",
      "border-left": "1px solid rgb(97, 109, 121)",
      "border-radius": "5px",
      "padding": "6px 9px"
    },
    "div.shell > main[main].main > div.filters > select[combobox] \"Domain\"": {
      "font-family": "Arial",
      "font-size": "13px",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(17, 22, 27)",
      "border-top": "1px solid rgb(97, 109, 121)",
      "border-right": "1px solid rgb(97, 109, 121)",
      "border-bottom": "1px solid rgb(97, 109, 121)",
      "border-left": "1px solid rgb(97, 109, 121)",
      "border-radius": "5px",
      "padding": "6px 9px"
    },
    "div.shell > main[main].main > div.panel": {
      "display": "block",
      "background-color": "rgb(21, 27, 33)",
      "border-top": "1px solid rgb(36, 45, 54)",
      "border-right": "1px solid rgb(36, 45, 54)",
      "border-bottom": "1px solid rgb(36, 45, 54)",
      "border-left": "1px solid rgb(36, 45, 54)",
      "border-radius": "6px",
      "padding": "14px 16px",
      "margin": "0px 0px 14px"
    },
    "div.shell > main[main].main > div.panel > h2[heading] \"NETWORK (2)\"": {
      "color": "rgb(139, 152, 165)",
      "font-size": "12px",
      "font-weight": "600",
      "letter-spacing": "0.7px",
      "text-transform": "uppercase",
      "display": "block",
      "margin": "0px 0px 10px"
    },
    "div.shell > main[main].main > div.panel > h2[heading] \"NETWORK (2)\" > span.count": {
      "font-weight": "400",
      "display": "inline"
    },
    "div.shell > main[main].main > div.panel > table[table].data": {
      "font-size": "13px",
      "display": "table"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup]": {
      "display": "table-header-group"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row]": {
      "display": "table-row"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"ACTION\"": {
      "color": "rgb(139, 152, 165)",
      "font-size": "11.5px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "padding": "6px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"KIND\"": {
      "color": "rgb(139, 152, 165)",
      "font-size": "11.5px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "padding": "6px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader] \"DESCRIPTION\"": {
      "color": "rgb(139, 152, 165)",
      "font-size": "11.5px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "padding": "6px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > thead[rowgroup] > tr[row] > th[columnheader]": {
      "color": "rgb(139, 152, 165)",
      "font-size": "11.5px",
      "font-weight": "600",
      "letter-spacing": "0.5px",
      "text-transform": "uppercase",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "padding": "6px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tbody": {
      "display": "table-row-group"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable": {
      "display": "table-row"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell].mono \"add-latency\"": {
      "font-family": "\"SF Mono\", \"JetBrains Mono\", ui-monospace, Menlo, Consolas, monospace",
      "font-size": "11.96px",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(36, 45, 54)",
      "padding": "7px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell].mono \"add-latency\" > a[link].row-link \"add-latency\"": {
      "display": "inline"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell] \"action\"": {
      "display": "table-cell",
      "border-bottom": "1px solid rgb(36, 45, 54)",
      "padding": "7px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell] \"action\" > span.badge.warn": {
      "color": "rgb(245, 158, 11)",
      "font-size": "11.5px",
      "font-weight": "600",
      "letter-spacing": "0.3px",
      "display": "inline-block",
      "background-color": "color(srgb 0.205333 0.177804 0.117333)",
      "border-radius": "10px",
      "padding": "1px 9px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell] \"Add latency to the traffic of an interfa…\"": {
      "color": "rgb(139, 152, 165)",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(36, 45, 54)",
      "padding": "7px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable > td[cell] \"Use →\"": {
      "color": "rgb(94, 177, 239)",
      "display": "table-cell",
      "border-bottom": "1px solid rgb(36, 45, 54)",
      "padding": "7px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable #2": {
      "display": "table-row"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable #2 > td[cell].mono \"ping\"": {
      "font-family": "\"SF Mono\", \"JetBrains Mono\", ui-monospace, Menlo, Consolas, monospace",
      "font-size": "11.96px",
      "display": "table-cell",
      "padding": "7px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable #2 > td[cell].mono \"ping\" > a[link].row-link \"ping\"": {
      "display": "inline"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable #2 > td[cell] \"probe\"": {
      "display": "table-cell",
      "padding": "7px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable #2 > td[cell] \"probe\" > span.badge.neutral": {
      "color": "rgb(139, 152, 165)",
      "font-size": "11.5px",
      "font-weight": "600",
      "letter-spacing": "0.3px",
      "display": "inline-block",
      "background-color": "rgb(28, 36, 44)",
      "border-radius": "10px",
      "padding": "1px 9px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable #2 > td[cell] \"Check that a host answers\"": {
      "color": "rgb(139, 152, 165)",
      "display": "table-cell",
      "padding": "7px 10px"
    },
    "div.shell > main[main].main > div.panel > table[table].data > tr[row].clickable #2 > td[cell] \"Use →\"": {
      "color": "rgb(94, 177, 239)",
      "display": "table-cell",
      "padding": "7px 10px"
    },
    "div": {
      "display": "block"
    }
  }
}

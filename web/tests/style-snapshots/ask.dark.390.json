{
  "page": "ask",
  "path": "/ask",
  "theme": "dark",
  "width": 390,
  "height": 844,
  "elements": {
    "html": {
      "color": "rgb(216, 222, 228)",
      "font-family": "-apple-system, \"Segoe UI\", Inter, Roboto, sans-serif",
      "font-size": "14px",
      "font-weight": "400",
      "line-height": "1.5",
      "letter-spacing": "normal",
      "text-transform": "none",
      "visibility": "visible",
      "display": "block",
      "background-color": "rgb(11, 14, 17)"
    },
    "body": {
      "display": "block",
      "background-color": "rgb(11, 14, 17)"
    },
    "a[link].sr-only.skip-link \"Skip to main content\"": {
      "color": "rgb(94, 177, 239)",
      "display": "block"
    },
    "div.shell": {
      "display": "block",
      "grid-template-columns": "208px 1fr"
    },
    "div.shell > header[banner].topbar": {
      "display": "flex",
      "background-color": "rgb(17, 22, 27)",
      "border-bottom": "1px solid rgb(36, 45, 54)",
      "padding": "8px 16px"
    },
    "div.shell > header[banner].topbar > span.name": {
      "font-size": "17px",
      "font-weight": "700",
      "letter-spacing": "0.4px",
      "display": "block"
    },
    "div.shell > header[banner].topbar > button[button].btn \"Menu\"": {
      "font-family": "Arial",
      "font-size": "13px",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(28, 36, 44)",
      "border-top": "1px solid rgb(51, 64, 76)",
      "border-right": "1px solid rgb(51, 64, 76)",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "border-left": "1px solid rgb(51, 64, 76)",
      "border-radius": "6px",
      "padding": "6px 14px"
    },
    "div.shell > main[main].main": {
      "display": "block",
      "padding": "22px 16px 60px"
    },
    "div.shell > main[main].main > div.page-head": {
      "display": "flex",
      "margin": "0px 0px 18px",
      "gap": "14px"
    },
    "div.shell > main[main].main > div.page-head > h1[heading] \"Ask\"": {
      "font-size": "19px",
      "font-weight": "600",
      "display": "block"
    },
    "div.shell > main[main].main > div.page-head > span.sub": {
      "color": "rgb(139, 152, 165)",
      "font-size": "12.5px",
      "display": "block"
    },
    "div.shell > main[main].main > div.panel": {
      "display": "block",
      "background-color": "rgb(21, 27, 33)",
      "border-top": "1px solid rgb(36, 45, 54)",
      "border-right": "1px solid rgb(36, 45, 54)",
      "border-bottom": "1px solid rgb(36, 45, 54)",
      "border-left": "1px solid rgb(36, 45, 54)",
      "border-radius": "6px",
      "padding": "14px 16px",
      "margin": "0px 0px 14px"
    },
    "div.shell > main[main].main > div.panel > form[form].askbar": {
      "display": "flex",
      "gap": "10px"
    },
    "div.shell > main[main].main > div.panel > form[form].askbar > input[textbox] \"Question\"": {
      "font-family": "Arial",
      "font-size": "13px",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(17, 22, 27)",
      "border-top": "1px solid rgb(51, 64, 76)",
      "border-right": "1px solid rgb(51, 64, 76)",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "border-left": "1px solid rgb(51, 64, 76)",
      "border-radius": "5px",
      "padding": "6px 9px"
    },
    "div.shell > main[main].main > div.panel > form[form].askbar > button[button].primary \"Ask\"": {
      "color": "rgb(255, 255, 255)",
      "font-family": "Arial",
      "font-size": "13px",
      "line-height": "normal",
      "display": "block",
      "opacity": "0.5",
      "background-color": "rgb(45, 93, 132)",
      "border-top": "1px solid rgb(94, 177, 239)",
      "border-right": "1px solid rgb(94, 177, 239)",
      "border-bottom": "1px solid rgb(94, 177, 239)",
      "border-left": "1px solid rgb(94, 177, 239)",
      "border-radius": "5px",
      "padding": "7px 16px"
    },
    "div.shell > main[main].main > div.panel > div.examples": {
      "display": "flex",
      "margin": "10px 0px 0px",
      "gap": "8px"
    },
    "div.shell > main[main].main > div.panel > div.examples > button[button] \"How many experiments ran?\"": {
      "color": "rgb(139, 152, 165)",
      "font-family": "Arial",
      "font-size": "12px",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(28, 36, 44)",
      "border-top": "1px solid rgb(51, 64, 76)",
      "border-right": "1px solid rgb(51, 64, 76)",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "border-left": "1px solid rgb(51, 64, 76)",
      "border-radius": "12px",
      "padding": "3px 11px"
    },
    "div.shell > main[main].main > div.panel > div.examples > button[button] \"What is the pass rate?\"": {
      "color": "rgb(139, 152, 165)",
      "font-family": "Arial",
      "font-size": "12px",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(28, 36, 44)",
      "border-top": "1px solid rgb(51, 64, 76)",
      "border-right": "1px solid rgb(51, 64, 76)",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "border-left": "1px solid rgb(51, 64, 76)",
      "border-radius": "12px",
      "padding": "3px 11px"
    },
    "div.shell > main[main].main > div.panel > div.examples > button[button] \"Which experiments failed?\"": {
      "color": "rgb(139, 152, 165)",
      "font-family": "Arial",
      "font-size": "12px",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(28, 36, 44)",
      "border-top": "1px solid rgb(51, 64, 76)",
      "border-right": "1px solid rgb(51, 64, 76)",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "border-left": "1px solid rgb(51, 64, 76)",
      "border-radius": "12px",
      "padding": "3px 11px"
    },
    "div.shell > main[main].main > div.panel > div.examples > button[button] \"What faults were injected?\"": {
      "color": "rgb(139, 152, 165)",
      "font-family": "Arial",
      "font-size": "12px",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(28, 36, 44)",
      "border-top": "1px solid rgb(51, 64, 76)",
      "border-right": "1px solid rgb(51, 64, 76)",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "border-left": "1px solid rgb(51, 64, 76)",
      "border-radius": "12px",
      "padding": "3px 11px"
    },
    "div.shell > main[main].main > div.panel > div.examples > button[button] \"Experiments per day\"": {
      "color": "rgb(139, 152, 165)",
      "font-family": "Arial",
      "font-size": "12px",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(28, 36, 44)",
      "border-top": "1px solid rgb(51, 64, 76)",
      "border-right": "1px solid rgb(51, 64, 76)",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "border-left": "1px solid rgb(51, 64, 76)",
      "border-radius": "12px",
      "padding": "3px 11px"
    },
    "div.shell > main[main].main > div.panel > div.examples > button[button] \"Show recent experiments\"": {
      "color": "rgb(139, 152, 165)",
      "font-family": "Arial",
      "font-size": "12px",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(28, 36, 44)",
      "border-top": "1px solid rgb(51, 64, 76)",
      "border-right": "1px solid rgb(51, 64, 76)",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "border-left": "1px solid rgb(51, 64, 76)",
      "border-radius": "12px",
      "padding": "3px 11px"
    },
    "div": {
      "display": "block"
    }
  }
}

{
  "page": "login",
  "path": "/login",
  "theme": "dark",
  "width": 1440,
  "height": 900,
  "elements": {
    "html": {
      "color": "rgb(216, 222, 228)",
      "font-family": "-apple-system, \"Segoe UI\", Inter, Roboto, sans-serif",
      "font-size": "14px",
      "font-weight": "400",
      "line-height": "1.5",
      "letter-spacing": "normal",
      "text-transform": "none",
      "visibility": "visible",
      "display": "block",
      "background-color": "rgb(11, 14, 17)"
    },
    "body": {
      "display": "block",
      "background-color": "rgb(11, 14, 17)"
    },
    "div.login-wrap": {
      "display": "flex"
    },
    "div.login-wrap > div.panel.login-panel": {
      "display": "block",
      "background-color": "rgb(21, 27, 33)",
      "border-top": "1px solid rgb(36, 45, 54)",
      "border-right": "1px solid rgb(36, 45, 54)",
      "border-bottom": "1px solid rgb(36, 45, 54)",
      "border-left": "1px solid rgb(36, 45, 54)",
      "border-radius": "6px",
      "padding": "14px 16px"
    },
    "div.login-wrap > div.panel.login-panel > div.brand": {
      "display": "block",
      "border-bottom": "1px solid rgb(36, 45, 54)",
      "padding": "0px 0px 12px",
      "margin": "0px 0px 16px"
    },
    "div.login-wrap > div.panel.login-panel > div.brand > h1[heading].name \"Tumult\"": {
      "font-size": "17px",
      "font-weight": "700",
      "letter-spacing": "0.4px",
      "display": "block"
    },
    "div.login-wrap > div.panel.login-panel > div.brand > div.tag": {
      "color": "rgb(91, 103, 114)",
      "font-size": "11px",
      "display": "block",
      "margin": "2px 0px 0px"
    },
    "div.login-wrap > div.panel.login-panel > form[form]": {
      "display": "flex",
      "gap": "12px"
    },
    "div.login-wrap > div.panel.login-panel > form[form] > label[LabelText]": {
      "color": "rgb(139, 152, 165)",
      "font-size": "12.5px",
      "display": "flex",
      "gap": "5px"
    },
    "div.login-wrap > div.panel.login-panel > form[form] > label[LabelText] > input[textbox] \"Username\"": {
      "color": "rgb(216, 222, 228)",
      "font-family": "Arial",
      "font-size": "13px",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(17, 22, 27)",
      "border-top": "1px solid rgb(51, 64, 76)",
      "border-right": "1px solid rgb(51, 64, 76)",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "border-left": "1px solid rgb(51, 64, 76)",
      "border-radius": "5px",
      "padding": "6px 9px"
    },
    "div.login-wrap > div.panel.login-panel > form[form] > label[LabelText] #2": {
      "color": "rgb(139, 152, 165)",
      "font-size": "12.5px",
      "display": "flex",
      "gap": "5px"
    },
    "div.login-wrap > div.panel.login-panel > form[form] > label[LabelText] #2 > input[textbox] \"Password\"": {
      "color": "rgb(216, 222, 228)",
      "font-family": "Arial",
      "font-size": "13px",
      "line-height": "normal",
      "display": "block",
      "background-color": "rgb(17, 22, 27)",
      "border-top": "1px solid rgb(51, 64, 76)",
      "border-right": "1px solid rgb(51, 64, 76)",
      "border-bottom": "1px solid rgb(51, 64, 76)",
      "border-left": "1px solid rgb(51, 64, 76)",
      "border-radius": "5px",
      "padding": "6px 9px"
    },
    "div.login-wrap > div.panel.login-panel > form[form] > button[button].primary \"Sign in\"": {
      "color": "rgb(255, 255, 255)",
      "font-family": "Arial",
      "font-size": "13px",
      "line-height": "normal",
      "display": "block",
      "opacity": "0.5",
      "background-color": "rgb(45, 93, 132)",
      "border-top": "1px solid rgb(94, 177, 239)",
      "border-right": "1px solid rgb(94, 177, 239)",
      "border-bottom": "1px solid rgb(94, 177, 239)",
      "border-left": "1px solid rgb(94, 177, 239)",
      "border-radius": "5px",
      "padding": "7px 16px"
    },
    "div": {
      "display": "block"
    }
  }
}

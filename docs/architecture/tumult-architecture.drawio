        <mxCell id="de7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.8;entryX=0;entryY=0.9;" edge="1" source="df-rollback" target="df-journal" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="660" /><mxPoint x="900" y="470" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="de8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.3;entryX=0.5;entryY=0;" edge="1" source="df-method" target="df-otel" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="280" /><mxPoint x="850" y="520" /><mxPoint x="1050" y="520" /></Array></mxGeometry>

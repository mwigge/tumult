  </diagram>
  <diagram id="tumult-plugin-system" name="Plugin System">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="ps-title" value="Tumult — Plugin System" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="300" height="60" as="geometry" />
        </mxCell>

        <!-- Experiment references plugin -->
        <mxCell id="ps-exp" value="experiment.toon&#xa;&#xa;provider:&#xa;  type: script&#xa;  plugin: tumult-kafka&#xa;  function: kill-broker&#xa;  arguments: ..." style="shape=document;whiteSpace=wrap;html=1;size=20;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="200" height="130" as="geometry" />
        </mxCell>

        <!-- Plugin Registry -->
        <mxCell id="ps-registry" value="tumult-plugin: script discovery&#xa;&#xa;1. Explicit config.plugin_paths&#xa;2. ./plugins/ (current directory)&#xa;3. ~/.tumult/plugins/ (user)&#xa;4. TUMULT_PLUGIN_PATH (colon-separated)&#xa;First name wins; malformed/shadowed warn&#xa;Native registry is separate, not a search path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="80" width="300" height="150" as="geometry" />
        </mxCell>

        <!-- Resolve -->
        <mxCell id="ps-resolve" value="tumult-exec&#xa;ProviderExecutor&#xa;Dispatch declared type" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="280" width="230" height="80" as="geometry" />
        </mxCell>

        <!-- Native path -->
        <mxCell id="ps-native" value="Native provider&#xa;&#xa;NativeExecutorRegistry::dispatch&#xa;NativeExecutor::execute (async)&#xa;In-process; validate plugin/function&#xa;ssh / net / kubernetes / cloud / windows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="270" height="120" as="geometry" />
        </mxCell>

        <!-- Script path -->
        <mxCell id="ps-script" value="Script provider&#xa;&#xa;1. Discover plugin.toon + canonical root&#xa;2. Find function: actions, then probes&#xa;3. Validate path / args; TUMULT_* env&#xa;4. /bin/sh subprocess (POSIX only)&#xa;5. Capture stdout/stderr/exit; timeout kills group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="420" width="300" height="130" as="geometry" />
        </mxCell>

        <!-- OTel Wrapper -->
        <mxCell id="ps-otel" value="Execution evidence / telemetry&#xa;&#xa;Runner activity spans: resilience.action / .probe&#xa;Script child span: script.execute&#xa;  script.path / script.timeout_seconds&#xa;  script.started / completed / timed_out events&#xa;Native providers add their own domain spans&#xa;ActivityOutcome → ActivityResult (journal)&#xa;trace_id / span_id / output / error / duration_ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="500" height="150" as="geometry" />
        </mxCell>

        <!-- Execution Target -->
        <mxCell id="ps-target" value="Execution location is provider-defined&#xa;&#xa;Process / script: local subprocess (may call docker / kubectl)&#xa;Native SSH: remote command via tumult-ssh&#xa;Native Kubernetes / cloud: target APIs&#xa;Native net: local userspace TCP proxy&#xa;ExecutionTarget model is not a generic transport dispatcher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="650" width="410" height="150" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="pe1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="ps-exp" target="ps-registry" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="ps-registry" target="ps-resolve" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe3" value="native" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;" edge="1" source="ps-resolve" target="ps-native" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe4" value="script" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;" edge="1" source="ps-resolve" target="ps-script" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="ps-native" target="ps-otel" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.4;exitY=1;entryX=0.8;entryY=0;" edge="1" source="ps-script" target="ps-otel" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="610" /><mxPoint x="440" y="610" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="pe7" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="ps-script" target="ps-target" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ps-process" value="Process provider&#xa;Command + arguments + environment&#xa;Local child process / configured timeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="440" width="290" height="80" as="geometry" /></mxCell>
        <mxCell id="pe-process" value="process" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="ps-resolve" target="ps-process" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

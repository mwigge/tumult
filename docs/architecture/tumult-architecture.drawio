        <!-- FAIL path from SSH before -->
        <mxCell id="de-fail" value="FAIL → abort" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#b85450;fontColor=#b85450;fontSize=10;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="df-ssh-before" target="df-rollback" parent="1">

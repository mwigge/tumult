        </mxCell>

        <!-- Journal Output -->
        <mxCell id="df-journal" value="journal.toon (final result)&#xa;&#xa;• completed / deviated / failed /&#xa;  interrupted / aborted / halted&#xa;• timestamps + durations&#xa;• steady_state_before / after&#xa;• method / rollback results&#xa;• during / post samples, load&#xa;• halt / blast radius / analysis&#xa;• trace_id + span_id per activity&#xa;&#xa;CLI: optional auto-ingest into&#xa;DuckDB / daemon API / ClickHouse" style="shape=document;whiteSpace=wrap;html=1;size=20;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="250" width="260" height="240" as="geometry" />
        </mxCell>

        <!-- OTel Export -->
        <mxCell id="df-otel" value="OTel OTLP Export&#xa;&#xa;Traces (spans per activity)&#xa;Metrics (counters, histograms)&#xa;Logs (structured events)" style="shape=cylinder3;whiteSpace=wrap;html=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="540" width="260" height="120" as="geometry" />
        </mxCell>

        <!-- Edges -->
